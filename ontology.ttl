<http://example.org/text-ontology/entity/sap-joule> a ns2:Entity,
        <http://example.org/text-ontology/class/entity>,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "SAP Joule" ;
    ns2:kind "Entity" ;
    ns3:product-of <http://example.org/text-ontology/entity/sap> ;
    rdfs:comment "SAP AI assistant capability; strong interest in understanding its capabilities, whether practical experience is available, and integrating the Joule experience into existing enterprise workflows and SAP ecosystem" ;
    skos:altLabel "Joule" ;
    skos:prefLabel "SAP Joule" .

<http://example.org/text-ontology/entity/solution-cockpit> a ns2:Entity,
