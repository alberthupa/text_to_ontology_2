<http://example.org/text-ontology/entity/pet-nutrition-commercial-performance-copilot> a ns2:Entity,
        <http://example.org/text-ontology/class/project>,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Pet Nutrition Commercial Performance Copilot" ;
    ns4:backend-approach "Codex-style repository skills running deterministic analyses returning answers, tables, and charts" ;
    ns4:brand-count "8" ;
    ns4:channels "Modern Grocery, Pet Specialist, Digital Commerce, Convenience" ;
    ns4:customer-count "14" ;
    ns4:data-coverage "FY 2024 P01-P13 as inferred baseline; FY 2025 P01-P13 as dashboard-anchored data; FY 2026 P01-P04 as synthetic demo data" ;
    ns4:data-source "Pet Nutrition synthetic demo database: 50,400 fact rows; FY2024 P01-P13 inferred baseline; FY2025 P01-P13 dashboard-anchored; FY2026 P01-P04 synthetic; 15 reporting units; 14 customers; 8 brands" ;
    ns4:disclosure "2026 values and detailed allocations are synthetic; promotion scenarios are modeled assumptions and should not be presented as proven historical causality" ;
    ns4:fact-row-count "50,400" ;
    ns4:front-end "Chainlit (chat and voice interaction)" ;
    ns4:main-dimensions "brand, customer, global channel, reporting unit, reporting region, fiscal year and period" ;
    ns4:measures "net sales (USD millions), volume (kilotonnes), gross margin (USD millions), gross margin percentage calculated after aggregation" ;
    ns4:reporting-unit-count "15" ;
    ns4:skills "dataset-profile, kpi-compare, variance-contributors, margin-target-gap, promotion-causal-scenario, sql-analysis, skill-smoke" ;
    ns4:stage "early stage proposal" ;
    ns4:status "proposal prototype, not a production Mars system" ;
    ns4:topic "Pet Nutrition Commercial Performance Copilot - agent-based assistant for commercial performance questions" ;
    ns2:kind "Project" ;
    ns3:client <http://example.org/text-ontology/entity/mars> ;
    ns3:includes-brand <http://example.org/text-ontology/entity/catsan>,
        <http://example.org/text-ontology/entity/cesar-essence>,
        <http://example.org/text-ontology/entity/dreamies>,
        <http://example.org/text-ontology/entity/iams>,
        <http://example.org/text-ontology/entity/pedigree>,
        <http://example.org/text-ontology/entity/perfect-fit>,
        <http://example.org/text-ontology/entity/sheba>,
        <http://example.org/text-ontology/entity/whiskas> ;
    ns3:proposed-to <http://example.org/text-ontology/entity/lexie-newlands> ;
    rdfs:comment "Early-stage proposal demo for Mars: agent-based assistant for commercial performance questions using a Chainlit front end and Codex-style repository skills on a synthetic Pet Nutrition demo database; a prototype, not a production Mars system" ;
    skos:altLabel "Lexie Proposal Demo",
        "Mars / Lexie Proposal Demo" ;
    skos:prefLabel "Pet Nutrition Commercial Performance Copilot" .

