    ns4:email "sanoj.kumar@effem.com" ;
    ns2:kind "Person" ;
    rdfs:comment "Contact at Mars client listed alongside Manish Danani on the semantic enablement / knowledge graph proposal" ;
    skos:altLabel "sanoj.kumar@effem.com" ;
