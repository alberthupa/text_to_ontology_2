<http://example.org/text-ontology/entity/universal-semantic-layer> a ns2:Entity,
        <http://example.org/text-ontology/class/project>,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Universal Semantic Layer" ;
    ns4:main-interest "Data and context become strategic assets" ;
    ns2:kind "Project" ;
    ns3:relates-to <http://example.org/text-ontology/entity/sap> ;
    rdfs:comment "Initiative to establish one semantic layer across platforms so data and context become strategic assets; questions on how SAP, knowledge graph and enterprise context connect, whether graphs can serve both humans and agents, and how to avoid duplicating semantics outside SAP" ;
    skos:altLabel "one semantic layer",
        "universal semantic layer" ;
    skos:prefLabel "Universal Semantic Layer" .

