    ns4:goal "inspirational story leading the client to commission a project, preferably more work on semantic graph including utilizing mapped processes by AI" ;
    ns4:meeting-date "2026-06-09" ;
    ns4:next-step "follow-ups sent to client including a dedicated meeting on the semantic graph" ;
    ns4:stage "early stage proposal (informal, not formal)" ;
    ns4:status "informal, early stage; follow-up will include a dedicated meeting on the semantic graph" ;
    ns2:kind "Project" ;
    ns3:client <http://example.org/text-ontology/entity/pg> ;
    rdfs:comment "Early-stage, informal proposal to client PG on a universal semantic graph (mapping processes and utilizing them by AI); follow-up includes a dedicated meeting; aim is to have PG commission Lingaro a project; deliverable is a markdown file describing a slide deck" ;
    skos:altLabel "semantic graph",
        "universal semantic graph" ;
    skos:prefLabel "Universal semantic graph proposal for PG" .

