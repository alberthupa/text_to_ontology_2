@prefix class: <http://example.org/text-ontology/class/> .
@prefix entity: <http://example.org/text-ontology/entity/> .
@prefix fact: <http://example.org/text-ontology/fact/> .
@prefix onto: <http://example.org/text-ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix relation: <http://example.org/text-ontology/relation/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:EntityShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path skos:prefLabel ] ;
    sh:targetClass onto:Entity .

entity:canada a onto:Entity,
        class:location,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Canada" ;
    onto:kind "Location" ;
    rdfs:comment "Country whose NATO members, together with European members, significantly increased total defense outlays." ;
    skos:altLabel "Canadian" ;
    skos:prefLabel "Canada" .

entity:donald-trump a onto:Entity,
        class:person,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Donald Trump" ;
    fact:office "US President" ;
    onto:kind "Person" ;
    relation:demands entity:allied-hormuz-maritime-security-commitments ;
    relation:party-to entity:trump-xi-summit ;
    relation:planned-summit-with entity:xi-jinping ;
    rdfs:comment "US leader referenced as a party to a possible future summit with Xi" ;
    skos:altLabel "Trump",
        "US President Donald Trump" ;
    skos:prefLabel "Donald Trump" .

entity:emerging-military-technologies a onto:Entity,
        class:entity,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Emerging military technologies" ;
    onto:kind "Entity" ;
    rdfs:comment "Military technologies whose faster adoption NATO was considering." ;
    skos:prefLabel "Emerging military technologies" .

entity:kirill-dmitriev a onto:Entity,
        class:person,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Kirill Dmitriev" ;
    onto:kind "Person" ;
    relation:represents entity:russia ;
    relation:visited entity:united-states ;
    rdfs:comment "Russian envoy who visited Washington amid discussion of sanctions relief and possible peace terms." ;
    skos:prefLabel "Kirill Dmitriev" .

entity:long-range-strike-capacity a onto:Entity,
        class:entity,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Long-range strike capacity" ;
    onto:kind "Entity" ;
    rdfs:comment "A military capacity NATO was considering in 2026." ;
    skos:prefLabel "Long-range strike capacity" .

entity:maritime-security a onto:Entity,
        class:entity,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Maritime security" ;
    onto:kind "Entity" ;
    rdfs:comment "One of the security priorities NATO was considering alongside support for Ukraine." ;
    skos:altLabel "maritime insecurity" ;
    skos:prefLabel "Maritime security" .

entity:nato-2-percent-defense-spending-target a onto:Entity,
        class:policy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "NATO 2 percent defense spending target" ;
    fact:achievement "All NATO allies met the target in 2025" ;
    fact:target-level "2 percent of GDP" ;
    onto:kind "Policy" ;
    rdfs:comment "Target requiring allies to spend 2 percent of GDP on defense, met by all allies in 2025 according to alliance reporting." ;
    skos:altLabel "2 percent of GDP defense spending target" ;
    skos:prefLabel "NATO 2 percent defense spending target" .

entity:nato-burden-sharing a onto:Entity,
        class:entity,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "NATO burden sharing" ;
    fact:concerns "where allies deploy attention, assets, and political capital when several crises overlap" ;
    onto:kind "Entity" ;
    rdfs:comment "Long-running alliance debate over how allies divide spending, attention, assets, and political responsibility across overlapping crises." ;
    skos:altLabel "allied burden sharing",
        "burden-sharing story" ;
    skos:prefLabel "NATO burden sharing" .

entity:nvidia-gpu-routing-attempts a onto:Entity,
        class:event,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Nvidia GPU routing attempts" ;
    onto:kind "Event" ;
    relation:routes-restricted-gpus-of entity:nvidia ;
    relation:targets-buyers-in entity:china ;
    rdfs:comment "Reported attempts to move large volumes of servers containing restricted Nvidia GPUs toward Chinese buyers" ;
    skos:prefLabel "Nvidia GPU routing attempts" .

entity:paris-preparatory-talks a onto:Entity,
        class:event,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Paris preparatory talks" ;
    onto:kind "Event" ;
    relation:held-in entity:paris ;
    relation:prepares entity:trump-xi-summit ;
    rdfs:comment "Diplomatic talks held in Paris aimed at preparing a future Trump-Xi summit" ;
    skos:prefLabel "Paris preparatory talks" .

entity:renewable-energy-systems a onto:Entity,
        class:entity,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Renewable energy systems" ;
    onto:kind "Entity" ;
    relation:depends-on entity:rare-earths ;
    rdfs:comment "Energy systems that depend on critical minerals among other industrial inputs" ;
    skos:prefLabel "Renewable energy systems" .

entity:world-economic-forum a onto:Entity,
        class:organization,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "World Economic Forum" ;
    fact:ranks "geoeconomic confrontation as top near-term risk" ;
    onto:kind "Organization" ;
    relation:published entity:world-economic-forum-2026-global-risks-work ;
    rdfs:comment "International organization that publishes global risks work" ;
    skos:prefLabel "World Economic Forum" .

