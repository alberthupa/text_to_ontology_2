@prefix ns2: <http://example.org/text-ontology/> .
@prefix ns3: <http://example.org/text-ontology/relation/> .
@prefix ns4: <http://example.org/text-ontology/fact/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/text-ontology/entity/ai-bootcamp> a ns2:Entity,
        <http://example.org/text-ontology/class/project>,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "AI Bootcamp" ;
    ns4:participants-reached "~250" ;
    ns4:share-reaching-production "~11%" ;
    ns2:kind "Project" ;
    rdfs:comment "Bootcamp that reached ~250 people with strong engagement and prepared case studies, but only ~11% reached production; raises questions on why momentum drops after ideation and whether hackathons are too intensive for production" ;
    skos:altLabel "Bootcamp" ;
    skos:prefLabel "AI Bootcamp" .

<http://example.org/text-ontology/entity/chrome-agent-project> a ns2:Entity,
        <http://example.org/text-ontology/class/project>,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Chrome + Agent project" ;
    ns2:kind "Project" ;
    rdfs:comment "Project of interest cited as an example of a context-driven and dynamic interaction model" ;
    skos:prefLabel "Chrome + Agent project" .

<http://example.org/text-ontology/entity/claude> a ns2:Entity,
        <http://example.org/text-ontology/class/entity>,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Claude" ;
    ns2:kind "Entity" ;
    rdfs:comment "LLM discussed as a tool for exploration within enterprise AI tooling strategy" ;
    skos:prefLabel "Claude" .

<http://example.org/text-ontology/entity/copilot> a ns2:Entity,
        <http://example.org/text-ontology/class/entity>,
        owl:NamedIndividual,
