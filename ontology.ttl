# A small example graph produced by the pipeline. It uses only the neutral
# schema.org building blocks the extractor starts from: Event, Organization,
# Person, Place, Product, and Action.

@prefix onto:     <http://example.org/text-ontology/> .
@prefix entity:   <http://example.org/text-ontology/entity/> .
@prefix class:    <http://example.org/text-ontology/class/> .
@prefix relation: <http://example.org/text-ontology/relation/> .
@prefix fact:     <http://example.org/text-ontology/fact/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

# --- support: ontology header and the one seeded shape ------------------------

onto:ontology a owl:Ontology ;
    rdfs:label "Text to ontology example" .

onto:EntityShape a sh:NodeShape ;
    sh:targetClass onto:Entity ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ] .

# --- schema: the neutral class and property core ------------------------------

onto:Entity a owl:Class ;
    rdfs:label "Entity" .

class:event a owl:Class ;
    rdfs:subClassOf onto:Entity ;
    rdfs:label "Event" .

class:organization a owl:Class ;
    rdfs:subClassOf onto:Entity ;
    rdfs:label "Organization" .

class:person a owl:Class ;
    rdfs:subClassOf onto:Entity ;
    rdfs:label "Person" .

class:place a owl:Class ;
    rdfs:subClassOf onto:Entity ;
    rdfs:label "Place" .

class:product a owl:Class ;
    rdfs:subClassOf onto:Entity ;
    rdfs:label "Product" .

class:action a owl:Class ;
    rdfs:subClassOf onto:Entity ;
    rdfs:label "Action" .

relation:employs a owl:ObjectProperty ;
    rdfs:domain class:organization ;
    rdfs:range class:person ;
    rdfs:label "employs" .

relation:located-in a owl:ObjectProperty ;
    rdfs:domain class:organization ;
    rdfs:range class:place ;
    rdfs:label "located in" .

relation:participates-in a owl:ObjectProperty ;
    rdfs:domain class:person ;
    rdfs:range class:event ;
    rdfs:label "participates in" .

relation:produces a owl:ObjectProperty ;
    rdfs:domain class:organization ;
    rdfs:range class:product ;
    rdfs:label "produces" .

fact:founded a owl:DatatypeProperty ;
    rdfs:domain class:organization ;
    rdfs:range xsd:gYear ;
    rdfs:label "founded" .

fact:name a owl:DatatypeProperty ;
    rdfs:domain onto:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "name" .

# --- instance: a few typed individuals ----------------------------------------

entity:acme a onto:Entity , owl:NamedIndividual , skos:Concept , class:organization ;
    skos:prefLabel "Acme" ;
    fact:founded "1994" .

entity:alice a onto:Entity , owl:NamedIndividual , skos:Concept , class:person ;
    skos:prefLabel "Alice" ;
    fact:name "Alice" .

entity:springfield a onto:Entity , owl:NamedIndividual , skos:Concept , class:place ;
    skos:prefLabel "Springfield" .

entity:widget a onto:Entity , owl:NamedIndividual , skos:Concept , class:product ;
    skos:prefLabel "Widget" .

entity:launch a onto:Entity , owl:NamedIndividual , skos:Concept , class:event ;
    skos:prefLabel "Widget Launch" .

entity:acme relation:employs entity:alice ;
    relation:located-in entity:springfield ;
    relation:produces entity:widget .

entity:alice relation:participates-in entity:launch .
