entity:rare-earths a onto:Entity,
        class:entity,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Rare earths" ;
    fact:shapes "industrial production and defense manufacturing" ;
    fact:strategic-status "strategic issue rather than a niche industrial topic" ;
    onto:kind "Entity" ;
    relation:concentrated-in-supply-chains-of entity:china ;
    rdfs:comment "Critical materials that shape industrial production and defense manufacturing" ;
    skos:altLabel "Critical minerals",
        "critical minerals",
        "rare-earth supply" ;
    skos:prefLabel "Rare earths" .

class:entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:subClassOf onto:Entity .

class:event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:subClassOf onto:Entity .

entity:china a onto:Entity,
        class:location,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "China" ;
    fact:advanced-chip-demand "Chinese technology firms continued large orders for high-end processors for 2026 delivery" ;
