<http://example.org/text-ontology/entity/pg> a ns2:Entity,
        <http://example.org/text-ontology/class/organization>,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "PG" ;
    ns4:ai-bootcamp-reach "~250 people" ;
    ns4:discussion-topics "Governance for Autonomous / Agentic AI; Adoption → Production Gap; Digital Factory as Enablement Model" ;
    ns4:share-of-bootcamp-initiatives-reaching-production "~11%" ;
    ns2:kind "Organization" ;
    rdfs:comment "Client of Lingaro (tagged #client #PG); met on 2026-06-09 at early proposal stage; talking informally with multiple vendors about problems/concerns" ;
    skos:altLabel "#PG",
        "#client",
        "the client" ;
    skos:prefLabel "PG" .

