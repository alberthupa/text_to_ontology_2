class:infrastructure a owl:Class ;
    rdfs:label "Infrastructure" ;
    rdfs:subClassOf onto:Entity .

entity:chinese-export-controls a onto:Entity,
        class:policy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Chinese export controls" ;
    fact:effect "immediate disruptions well beyond China" ;
    onto:kind "Policy" ;
    relation:limits-access-to entity:rare-earths ;
    rdfs:comment "Expanded export controls or tighter restrictions from Beijing that can create immediate disruptions well beyond China" ;
    skos:altLabel "tighter restrictions from Beijing" ;
    skos:prefLabel "Chinese export controls" .

entity:conflict-involving-iran a onto:Entity,
        class:event,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Conflict involving Iran" ;
    fact:affects "Asian energy importers",
        "European political choices",
        "global fuel prices" ;
    onto:kind "Event" ;
    relation:affects entity:europe ;
    relation:involves entity:iran ;
    rdfs:comment "Regional crisis involving Iran with effects beyond the region" ;
    skos:prefLabel "Conflict involving Iran" .

entity:east-asia a onto:Entity,
        class:location,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "East Asia" ;
    onto:kind "Location" ;
    rdfs:comment "Region affected by competition with China" ;
    skos:prefLabel "East Asia" .

entity:energy-markets a onto:Entity,
        class:entity,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Energy markets" ;
    onto:kind "Entity" ;
    rdfs:comment "Fuel and energy markets disrupted by regional conflicts and linked to mineral and industrial security" ;
    skos:prefLabel "Energy markets" .

entity:energy-shock a onto:Entity,
        class:event,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "energy shock" ;
    onto:kind "Event" ;
    relation:linked-to entity:conflict-involving-iran ;
    rdfs:comment "Mid-March energy-market shock linked to conflict involving Iran, during which the United States introduced a temporary sanctions waiver on Russian oil." ;
    skos:prefLabel "energy shock" .

entity:nato a onto:Entity,
        class:organization,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "NATO" ;
    fact:policy-emphasis "Stronger conventional deterrence, faster technology adoption, and sustained allied defense spending" ;
    onto:kind "Organization" ;
    relation:emphasizes entity:russian-refining-capacity ;
    rdfs:comment "Alliance that Russia reportedly wanted to pledge to stop expanding eastward and that emphasized stronger deterrence and defense spending." ;
    skos:prefLabel "NATO" .

entity:nvidia a onto:Entity,
        class:organization,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Nvidia" ;
    fact:gray-market-routing-case "attempts to move large volumes of servers containing restricted Nvidia GPUs toward Chinese buyers" ;
    onto:kind "Organization" ;
    relation:makes-restricted-gpus-among entity:advanced-chips ;
    relation:restricted-gpus-sought-by entity:china ;
    rdfs:comment "Chipmaker whose restricted GPUs were reportedly targeted for routing to Chinese buyers via servers" ;
    skos:prefLabel "Nvidia" .

entity:paris a onto:Entity,
        class:location,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Paris" ;
    fact:diplomatic-talks-purpose "preparing a future Trump-Xi summit while seeking managed stability" ;
    onto:kind "Location" ;
    rdfs:comment "City where officials held talks to prepare a future Trump-Xi summit" ;
    skos:prefLabel "Paris" .

entity:russia-ukraine-war a onto:Entity,
        class:event,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Russia-Ukraine war" ;
    onto:kind "Event" ;
    relation:affected entity:europe ;
    relation:affects entity:europe,
        entity:united-states ;
    relation:involves entity:russia,
        entity:ukraine ;
    rdfs:comment "Ongoing war between Russia and Ukraine whose effects are entangled with sanctions, oil-market management, and alliance politics." ;
    skos:altLabel "war in Ukraine" ;
    skos:prefLabel "Russia-Ukraine war" .

entity:temporary-us-sanctions-waiver-on-russian-oil a onto:Entity,
        class:policy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "temporary US sanctions waiver on Russian oil" ;
    fact:expiration-date "2026-04-11" ;
    fact:introduced "mid-March 2026" ;
    fact:introduced-date "2026-03" ;
    fact:justification "market-stabilization measure" ;
    fact:scheduled-expiry-date "2026-04-11" ;
    onto:kind "Policy" ;
    relation:introduced-during entity:energy-shock ;
    relation:waives-sanctions-on entity:russia ;
    relation:was-linked-to-conflict-involving entity:iran ;
    rdfs:comment "Temporary market-stabilization waiver introduced by the United States in mid-March during an energy shock and set to expire on April 11." ;
    skos:altLabel "US sanctions waiver" ;
    skos:prefLabel "temporary US sanctions waiver on Russian oil" .

entity:us-export-restrictions a onto:Entity,
        class:policy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "US export restrictions" ;
    fact:effect-on-demand "changed supply channels more than eliminated demand" ;
    onto:kind "Policy" ;
    relation:limits-access-of entity:china ;
    relation:limits-access-to entity:advanced-chips ;
    rdfs:comment "United States technology controls that limit China's formal access to advanced chips and can redirect trade into opaque channels" ;
    skos:altLabel "export controls",
        "technology controls" ;
    skos:prefLabel "US export restrictions" .

entity:world-economic-forum-2026-global-risks-work a onto:Entity,
        class:entity,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "World Economic Forum 2026 global risks work" ;
    fact:other-major-risks "interstate conflict, extreme weather, societal polarization, and misinformation" ;
    fact:top-near-term-risk "geoeconomic confrontation" ;
    onto:kind "Entity" ;
    rdfs:comment "WEF 2026 risks assessment placing geoeconomic confrontation first among near-term risks" ;
    skos:prefLabel "World Economic Forum 2026 global risks work" .

entity:xi-jinping a onto:Entity,
        class:person,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Xi Jinping" ;
    onto:kind "Person" ;
    relation:party-to entity:trump-xi-summit ;
    rdfs:comment "Chinese leader referenced as a party to a possible future summit with Trump" ;
    skos:altLabel "Xi" ;
    skos:prefLabel "Xi Jinping" .

entity:coordinated-mineral-strategy a onto:Entity,
        class:policy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Coordinated mineral strategy" ;
    fact:aim "price stability and reduced vulnerability" ;
    onto:kind "Policy" ;
    rdfs:comment "European and US approach aimed at price stability and reduced vulnerability if Chinese-controlled mineral supply is cut" ;
    skos:prefLabel "Coordinated mineral strategy" .

entity:iran a onto:Entity,
        class:location,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Iran" ;
    fact:affects "global fuel prices" ;
    onto:kind "Location" ;
    rdfs:comment "Country involved in conflict affecting global fuel prices" ;
    skos:prefLabel "Iran" .

entity:orthodox-easter-ceasefire a onto:Entity,
        class:event,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Orthodox Easter ceasefire" ;
    fact:outcome "both sides quickly accused the other of violations" ;
    onto:kind "Event" ;
    relation:occurred-during entity:russia-ukraine-war ;
    rdfs:comment "Short ceasefire announced during the war that both Russia and Ukraine quickly accused the other of violating." ;
    skos:prefLabel "Orthodox Easter ceasefire" .

entity:russian-refining-capacity a onto:Entity,
        class:infrastructure,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Russian refining capacity" ;
    onto:kind "Infrastructure" ;
    rdfs:comment "Russian energy infrastructure reportedly damaged by Ukrainian attacks sufficiently to affect export decisions." ;
    skos:altLabel "Russian energy infrastructure",
        "Russian refining capacity" ;
    skos:prefLabel "Russian refining capacity" .

entity:ukraine a onto:Entity,
        class:location,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Ukraine" ;
    fact:preferred-settlement-approach "freeze the conflict roughly along current lines" ;
    fact:settlement-preference "Freeze the conflict roughly along current lines" ;
    onto:kind "Location" ;
    relation:accused-of-violating entity:orthodox-easter-ceasefire ;
    relation:damaged entity:russian-refining-capacity ;
    rdfs:comment "Country at war with Russia that favored freezing the conflict roughly along current lines." ;
    skos:altLabel "Ukrainian" ;
    skos:prefLabel "Ukraine" .

class:person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf onto:Entity .

entity:advanced-chips a onto:Entity,
        class:entity,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Advanced chips" ;
    fact:depends-on "manufacturing inputs and specialized equipment" ;
    fact:shapes "AI capacity and high-end computing" ;
    onto:kind "Entity" ;
    relation:depends-on entity:rare-earths ;
    rdfs:comment "High-end semiconductors that shape AI capacity and high-end computing" ;
    skos:altLabel "high-end processors",
        "semiconductor access",
        "semiconductors" ;
    skos:prefLabel "Advanced chips" .

entity:european-union a onto:Entity,
        class:organization,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "European Union" ;
    onto:kind "Organization" ;
    relation:coordinates-with entity:united-states ;
    relation:pursues entity:coordinated-mineral-strategy ;
    relation:treats-overcapacity-as-economic-security-from entity:china ;
    rdfs:comment "Political union coordinating with Washington on critical minerals and treating Chinese overcapacity as economic security" ;
    skos:altLabel "Brussels",
        "EU",
        "European" ;
    skos:prefLabel "European Union" .

entity:russia a onto:Entity,
        class:location,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Russia" ;
    fact:preferred-settlement-approach "broader territorial concessions, written NATO non-expansion pledge, and easing of several sanctions" ;
    fact:reported-settlement-condition "A written pledge that NATO would stop expanding eastward",
        "Easing of several sanctions" ;
    fact:settlement-position "Rejected freezing the conflict along current lines and sought broader territorial concessions" ;
    onto:kind "Location" ;
    relation:accused-of-violating entity:orthodox-easter-ceasefire ;
    relation:fights entity:ukraine ;
    relation:sought-pledge-from entity:nato ;
    rdfs:comment "Country fighting Ukraine and seeking territorial concessions and sanctions easing in settlement talks." ;
    skos:altLabel "Moscow",
        "Russian" ;
    skos:prefLabel "Russia" .

entity:trump-xi-summit a onto:Entity,
        class:event,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Trump-Xi summit" ;
    onto:kind "Event" ;
    rdfs:comment "Possible future summit between Donald Trump and Xi Jinping that officials sought to prepare in Paris" ;
    skos:altLabel "future Trump-Xi summit" ;
    skos:prefLabel "Trump-Xi summit" .

