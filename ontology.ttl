    rdfs:label "Copilot" ;
    ns2:kind "Entity" ;
    ns3:compared-with <http://example.org/text-ontology/entity/ai-factory> ;
    rdfs:comment "AI tool compared against AI Factory in the enterprise AI tooling strategy discussion" ;
    skos:prefLabel "Copilot" .

<http://example.org/text-ontology/entity/digital-factory> a ns2:Entity,
        <http://example.org/text-ontology/class/project>,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Digital Factory" ;
    ns4:main-interest "Creating an operating system for scaling AI" ;
    ns2:kind "Project" ;
    rdfs:comment "Enablement model discussed as an operating system for scaling AI; ideas include T-shirt sizing support model, portfolio visibility and governance, structured journey from idea to build to production, and practitioner-led delivery embedded in business processes" ;
    skos:altLabel "Digital Factory as Enablement Model" ;
    skos:prefLabel "Digital Factory" .

<http://example.org/text-ontology/entity/maciej-mroz> a ns2:Entity,
