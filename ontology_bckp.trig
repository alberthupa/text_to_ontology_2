    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-4032020ec4df48a1/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Extend Postgres product/entity data with BLOZ identifier and is_polpharma flag (with migration/backfill), use BLOZ for DBAP packshot matching, avoid depending on Gremlin/graph for ownership, change Farmindex refresh from daily to weekly (Saturday night, test env first then production), and collect questionable ICD-10 mappings to report to Polpharma as source data quality issues." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

