        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/statement/918c3489cf1984ae98d1ec85b809933a2b0f0fb5fcbcffdd3f837f30857168d7> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/112e3b8a60567a0b308b02f613ca40652a4855b9862de7ad272a9a1aee20d01f> ;
        rdf:object "Dedicated tools are used for common scenarios where they exist; rare or unsupported scenarios are routed to the fallback reasoning node, which uses improved structured output and direct tool-call execution where applicable; the backlog distinguishes scenarios worth dedicated tooling from those left to fallback handling; a deterministic list-intersection tool is planned to combine results from multiple retrieval steps without hallucination." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-28b154549e870b67> .

