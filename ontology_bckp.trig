    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/4/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "End users want article and video recommendations that are more relevant than with vector-only or keyword-only search; solution developers want to determine whether vector-only similar-question retrieval is sufficient or whether hybrid search/reranking should be introduced." ;
        rdf:predicate fact:business-context ;
