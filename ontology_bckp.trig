    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-c2c6863603ed8ec9/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-c2c6863603ed8ec9/fact/1/statement/0> ;
