    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5aa83fa3c8ae7567/entity/2/statement/4> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "European Medicines Agency guidance highlighting risk management, data quality, performance monitoring, bias mitigation, governance, data protection, and trustworthy AI; referenced as the governance mindset relevant to WAP." ;
        rdf:predicate skos:definition ;
        rdf:subject entity:ema-guidance-on-ai-in-the-medicinal-product-lifecycle ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

