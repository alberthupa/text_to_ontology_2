    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-4bbd8a892c898bdd/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Record and report suspected Farmindex ICD-10 data quality issues to Polpharma without correcting source data; optimize list-style ICD-10 responses by generating a short introduction with a small model or predefined pattern and appending the retrieved product list directly (no full list passed to the main LLM), with Polish grammatical correctness and regression tests; implement a dedicated ATC retrieval tool for drug-group questions." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

