    <http://example.org/text-ontology/candidate/doc-28b154549e870b67/win-09c05ed4963e45e7/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/112e3b8a60567a0b308b02f613ca40652a4855b9862de7ad272a9a1aee20d01f> ;
        rdf:object "Routing layer detects when the user asks about a drug property, determines which property or field is needed where possible, and invokes the AI Search-based drug-property retrieval tool for supported cases; routing design avoids excessively narrow low-level scenarios when a higher-level scenario is more manageable; question-paraphrasing node to generate concise system-oriented search queries so vector search retrieves more relevant examples without overweighting generic phrases such as 'the user asks about'." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
