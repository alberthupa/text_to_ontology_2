    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-52c5fbccd6ee3c47/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Review the current similar-question retrieval implementation: confirm whether it uses vector search, keyword search, hybrid search and/or reranking; document known quality concerns; propose improvement options such as hybrid search or semantic reranking; identify at least one representative failing or weak scenario; recommend whether to implement improvements now or keep as future optimization; no production behavior changed unless separately approved." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-52c5fbccd6ee3c47/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-52c5fbccd6ee3c47/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/d3807f944e653496> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-52c5fbccd6ee3c47/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Build a dedicated drug-interaction retrieval/tool integration: accepts at least two drug/product inputs, retrieves interaction information from the agreed source, interaction questions are routed to the tool, response clearly presents the source's interaction information, handles missing or ambiguous drug names gracefully; tests for two valid drugs, one unknown drug, and ambiguous product name; scope and source-data responsibility documented before implementation." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-52c5fbccd6ee3c47/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-52c5fbccd6ee3c47/fact/2/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/d3807f944e653496> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-52c5fbccd6ee3c47/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Add additional Langfuse metrics for key assistant behaviors requested by Polpharma: metrics identified and documented, added to Langfuse traces or sessions where appropriate, Langfuse not used as a decisioning/runtime dependency, compatible with existing tracing, inspectable by the team, tested in dev, limitations of Langfuse-based monitoring documented." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

