    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-693b8520c35bd0d5/entity/5/statement/4> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Conversation analytics layer of WAP collecting conversation topics and intents, failed/unresolved journeys, feedback signals (thumbs-up/down, comments), source usage and retrieval path, risk flags for answer quality and compliance, potential adverse-event signals, and LLM technical/cost telemetry; supports continuous improvement, quality monitoring, content gap detection and prioritization of future development." ;
        rdf:predicate skos:definition ;
        rdf:subject entity:wap-analytics-layer ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

