    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/0/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/4d0e135374a61fc6> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object "Core deliverables: automated entity extraction from documents into graph updates aligned with P&G's enterprise ontology; configuration-driven alignment layer (normalization, entity linking, merge/dedup) reusable across domains; ~20 business questions answered via Ask Timbr with traceable provenance to source documents; thin Streamlit UI for question input, answer display and provenance." ;
        rdf:predicate fact:project-summary ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-d713d0d4a0618548/p-g-text-to-graph-poc> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/4d0e135374a61fc6> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object "First use case Formulation Compliance: screen formulation ideas against North America federal regulations (Title 21, Title 16) using internal structured formulation data (cdl stc prod -> gold_stc: raw materials, substances, concentrations) to surface compliance risks early. Second use case (later): Engineering standards (internal data)." ;
        rdf:predicate fact:business-context ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-d713d0d4a0618548/p-g-text-to-graph-poc> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/2/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/4d0e135374a61fc6> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object "AI Factory (AIF) for application development, LLM endpoint and agent framework (pygentic / LangChain); Timbr / gtimbr as semantic/ontology layer hosted at timbrdev.pg.com; Databricks for compute (Timbr's current backend); GitHub, Jira, Confluence for project management; SharePoint for user-facing docs; blob storage for workflow execution." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-d713d0d4a0618548/p-g-text-to-graph-poc> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/3> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/3/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/4d0e135374a61fc6> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-a76459b6b2926175/fact/3/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object "As of 2026-04-13 lacking: access to 'large ontology' (branch expected); UC for dbrx workspace (supposedly not needed); dbrx workspace config (Marcin to do); dbrx SharePoint connector; access to stc_gold (expected); access to STCG-CFGPS and STCG-CFGPS-Perfume (won't be granted); gtimbr missing graph_algorithm_manager_url (Czeslaw Szczotka wrote to Timbr); Jira edit access (Marcin Sloka supposedly fixed)." ;
        rdf:predicate fact:open-issue ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-d713d0d4a0618548/p-g-text-to-graph-poc> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

