        fact:lingaro-context "Committed functionality for Polpharma includes article/regulation recommendation scenarios to be delivered alongside ICD-10 work." ;
        onto:kind "Client" ;
        relation:client-source-note entity:backlog-refinement-2026-05-22-pharma-assistant ;
        relation:client-uses-technology entity:microsoft-azure ;
        rdfs:comment "Pharmaceutical company; client for whom the Pharma Assistant project is delivered; products are distinguished as Polpharma vs non-Polpharma and data quality issues are to be reported to Polpharma." ;
