    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-f3215d7e74f90393/entity/3/statement/4> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Polish National Health Fund; its requirements define what a compliant reimbursement justification must look like." ;
        rdf:predicate skos:definition ;
        rdf:subject entity:nfz ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-b06762aea0d04870> .

    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-f3215d7e74f90393/entity/3/statement/5> a rdf:Statement ;
