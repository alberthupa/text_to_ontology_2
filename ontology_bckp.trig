        rdf:object "Disease/condition classification used by an existing retrieval tool in the assistant; ICD-10 may return broader product mappings than ATC; existing ICD-10 functionality must not be broken." ;
        rdf:predicate skos:definition ;
        rdf:subject entity:icd-10 ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

