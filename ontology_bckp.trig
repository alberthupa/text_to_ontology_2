    <http://example.org/text-ontology/statement/4fcbaf115de2bd15459ff3c60fa104e1641d27adb3005a2b02414e3099f28f66> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Natural-language interface over approved pharmaceutical knowledge sources covering product information and characteristics, active substances, contraindications and adverse reactions, interactions (where data sources/integrations available), reimbursement information, medical articles and educational materials, clinical calculators via integration, and contextual eDetailing materials for selected Polpharma products. Every medical/product answer must be traceable to source material (source grounding as core trust mechanism). Azure-based deployment in Polpharma-provided cloud; modular, API-first, cloud-native architecture using managed Azure services; Graph RAG and hybrid retrieval. Governance emphasis: Responsible AI, AI Act awareness, auditability, human oversight, controlled knowledge grounding." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

