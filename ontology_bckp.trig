    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-c2c6863603ed8ec9/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Project to define possibilities of using modern technologies, including AI, to improve UX and increase user engagement of the polpharmadlaciebie.pl service; identified possibilities will be prioritised and the most important functions specified and implemented in the service." ;
        rdf:predicate fact:project-summary ;
