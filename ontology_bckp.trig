        rdf:object "Add non-streaming endpoint support for article/video retrieval responses, aligned with the streaming endpoint structure, compatible with frontend expectations, supporting article and video result types, with consistent result-label mapping and without breaking existing streaming behavior." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

