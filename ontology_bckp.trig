    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object "12-week POC (March 16 – June 12, 2026) for P&G delivered by Lingaro to operationalize Timbr's experimental text-to-graph capability: unstructured documents (PDFs, P&ID diagrams, DEXPI XML) automatically converted into ontology-compliant knowledge-graph updates inside Timbr." ;
        rdf:predicate fact:project-summary ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-d713d0d4a0618548/p-g-text-to-graph-poc> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/91be7a51e145387e> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object "Automated entity extraction from documents into graph updates aligned with P&G's enterprise ontology; configuration-driven alignment layer (normalization, entity linking, merge/dedup) reusable across domains; ~20 business questions answered via Ask Timbr with traceable provenance to source documents; thin Streamlit UI for question input, answer display and provenance." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-d713d0d4a0618548/p-g-text-to-graph-poc> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/2/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/91be7a51e145387e> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object "P&G 'clean design' organization: equipment, utilities and facilities must not create contamination; design standards exist in every component, actual designs are in P&ID diagrams, currently a manual process. Data to model: links from equipment to risk levels, equipment hierarchy vs. risk statement types (general information, hard points, hardly acceptable). Regulation scope spans product origin/sale/consumption, consumer, product form, GTIN, formulation, packaging and packaging regulations (ESG, sustainability)." ;
        rdf:predicate fact:business-context ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-d713d0d4a0618548/p-g-text-to-graph-poc> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/3> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/3/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/91be7a51e145387e> .

    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-3b5ae2a71c9186a3/fact/3/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object "P&G's big issue is where regulations sit in the overall ontology; also to find standard semantics for chemical substances against regulations (IUCLID, UN GHS) and check them against Paweł's substance category." ;
        rdf:predicate fact:open-issue ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-d713d0d4a0618548/p-g-text-to-graph-poc> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

