    <http://example.org/text-ontology/statement/5f98fcdd9b021eb59e97bac4776d4714e6c68e0c5e85c1c9ba417f04a3c0a119> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Using the authorized doctor's location context, the system should indicate whether and where a drug is available to the patient; when a drug is unavailable it should suggest alternative drugs currently available in pharmacies and wholesalers; for reimbursed drugs it should display reimbursement information and rules and provide a ready, NFZ-compliant reimbursement justification template to paste; for drugs with parameter-dependent dosing it should give access to dose calculators, link to the relevant calculator when presenting results, and in dialogue collect required input parameters, ask for missing ones and return the computed dose." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-b06762aea0d04870> .

    <http://example.org/text-ontology/statement/5f9d00082c309efa6ffec7110da056ca2d365fe7f3eeb639b38e86a516230dfd> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object onto:Entity ;
        rdf:predicate rdf:type ;
        rdf:subject entity:pg-text-to-graph-poc-team ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

    <http://example.org/text-ontology/statement/5faebdb04e1dfb2ee85ad0e72ec77143755fd14d610b83db23f82bf3ce0c8b71> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "WAP operates in a medical and pharmaceutical information context, so it must be designed with safety, compliance and auditability from the start (Responsible AI, safety-by-design). Scope boundaries: WAP does not diagnose, replace clinical judgment or independently interpret clinical cases; it provides source-grounded information and access to approved knowledge. Human oversight per EU AI Act: audit trails for prompts, retrieved sources, model outputs and tool calls; review workflows for problematic answers; escalation paths for uncertain or risky content; user-facing disclaimers; monitoring of anomalies, hallucination risk and source gaps; analytics identifying where knowledge or prompts need improvement." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

