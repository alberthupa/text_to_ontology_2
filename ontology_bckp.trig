    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/0/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/00a7011b06443432> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Additional metrics required by Polpharma are identified, documented and added to Langfuse traces or sessions where technically appropriate, compatible with existing tracing, tested in dev, inspectable by the team in Langfuse; Langfuse is not used as a decisioning/runtime dependency and limitations of Langfuse-based monitoring are documented." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/00a7011b06443432> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "DBAP/Farmindex downtime or intermittent failures are logged with timestamp, context and failed operation (packshot retrieval, Farmindex reload, DBAP request) so source-system failures can be distinguished from application defects and explained to Polpharma; errors caused by source unavailability are not silently ignored; existing retry/error handling is reviewed and documented; no internal workaround unless separately scoped." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/2/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/00a7011b06443432> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Article/video result labels returned from CMS are reviewed for language consistency; team agrees whether labels remain in Polish or are translated to English for technical/frontend consistency; agreed convention applied consistently, mapping from CMS labels to frontend labels documented, Polish UI scenarios remain coherent, tests cover article and video result types." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/3> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/3/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/00a7011b06443432> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/3/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Videos without transcripts are skipped during indexing so that incomplete Vimeo uploads do not create broken or low-quality searchable records." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/4> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/4/statement/0> ;
