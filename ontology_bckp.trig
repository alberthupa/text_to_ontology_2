    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-c2c6863603ed8ec9/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Polpharma wants to increase engagement of users of the polpharmadlaciebie.pl service (doctors). A key medical problem is polypharmacy in an ageing society, where finding active ingredients and their potential interactions is time-consuming; support for the doctor's work in this area is seen as valuable. Potential functional requirements were collected during design thinking workshops held on 27.03.2024." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-b06762aea0d04870> .

    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-c2c6863603ed8ec9/fact/2> a prov:Collection ;
