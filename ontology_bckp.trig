    <http://example.org/text-ontology/statement/9104e5aa4b426991e5e52a4c6088e1302041c7a85e1d02a123cbeaebb72f4616> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/112e3b8a60567a0b308b02f613ca40652a4855b9862de7ad272a9a1aee20d01f> ;
        rdf:object "Evaluate whether semantic search or ranking improves few-shot example retrieval so irrelevant examples are less likely to be selected for Gremlin-related prompting; review current vector-search-based retrieval, check cases where superficially similar questions return semantically wrong examples, and recommend whether semantic search/ranking should replace or augment the current approach. Make the fallback reasoning node return concise structured output instead of long prose to reduce context size, latency and downstream failure risk." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-28b154549e870b67> .

    <http://example.org/text-ontology/statement/9177ee91055cc71e87f2c4d56da2f2a1e89a2ebc0abbb67d4b83727ffff73b43> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
