    <http://example.org/text-ontology/statement/7771925441316f6e8fc4bcaab9c35f42e50573e88878200a9a97e27cdbe91f83> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Append configurable (not hardcoded) GET/query parameters to article URLs returned by the assistant, managed via platform/admin configuration; preserve original URLs including existing query strings; parameters identify WAP or another agreed source value; no internal click analytics storage unless separately scoped; behavior documented for client analytics alignment." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/statement/77f6633428c9eab04a3af37080ee9b3bf0c2a08f04cd38a343e7c5f78730d206> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Build a dedicated drug-interaction retrieval/tool integration: accepts at least two drug/product inputs, retrieves interaction information from the agreed source, interaction questions are routed to the tool, response clearly presents the source's interaction information, handles missing or ambiguous drug names gracefully; tests for two valid drugs, one unknown drug, and ambiguous product name; scope and source-data responsibility documented before implementation." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/statement/7801244f7b7217b9d922f0794ead8caf0d8337b71a21370100bc7482bbf34b03> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Azure-native deployment aligned with Polpharma's Azure environment and security expectations: separate dev/test/prod environments, Infrastructure-as-Code provisioning, managed identities and Key Vault for secrets, private network patterns where required, observable runtime with traceable LLM interactions, controlled access to data sources and logs, documented APIs for portal or widget integration. Core stack: Azure OpenAI; LangChain/LangGraph orchestration; LiteLLM gateway; Azure AI Search, vector search and graph/Gremlin retrieval; Python API-first backend with web frontend integration; PostgreSQL, Cosmos DB, Redis, ClickHouse data layer; Langfuse, Application Insights, Log Analytics observability; Terraform and Azure DevOps CI/CD." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/statement/78077e49f55d012e461506b803b9fcf93ac59076860700220fa036232aaa8252> a rdf:Statement,
