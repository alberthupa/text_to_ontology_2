    <http://example.org/text-ontology/statement/2f4f4f05562d29e27533e087a274e7b00cb63249634620af5ec97cdadda5a0e0> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Polish medical NLP: recognition of medicines, active substances, diseases, ICD-10 codes, adverse effects, contraindications and related pharmaceutical concepts; normalization of Polish medical terminology; handling of inflection and synonymy; intent classification into supported conversational flows; clarification of ambiguous or under-specified queries. eDetailing module acting as digital medical representative: detect mentions linked with promotional materials, track materials shown, respect frequency/visibility preferences, answer questions about displayed materials from indexed content, cite source fragments. Analytics layer: conversation topics and intents, failed/unresolved journeys, thumbs-up/down feedback and comments, source usage and retrieval path, risk flags for answer quality and compliance, potential adverse-event signals, LLM technical and cost telemetry - supporting continuous improvement, quality monitoring, content gap detection and prioritization of future development." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

