    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-04aa7cc8f65bb1fe/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Funkcje historii rozmów mają zapewnić lekarzowi dostęp do wiedzy przydatnej w terapii obecnych pacjentów lub w obrębie specjalizacji oraz pomóc uniknąć pomyłek przy rutynowym zapisywaniu leków po zmianach refundacyjnych." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-b06762aea0d04870> .

