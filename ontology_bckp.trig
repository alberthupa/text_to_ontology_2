    <http://example.org/text-ontology/statement/a3ffde35ab7ac41f6569a78387b26c30899b5938cebe9370a8ab907a201645cf> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Map Vimeo videos to Squiz/CMS IDs by extracting the CMS ID from the Vimeo description field; handle and log records without required IDs, support partial video availability during uploads, avoid indexing unmatched videos as valid CMS-linked content, cover mapping logic with tests (valid, missing, malformed ID) and document the extraction format for content teams." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/statement/a4862a95e0e65052123283b3414131f9cdd8a607fdbc067584460b681355c8f0> a rdf:Statement,
            prov:Entity ;
