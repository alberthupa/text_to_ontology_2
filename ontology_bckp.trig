    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5aa83fa3c8ae7567/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5aa83fa3c8ae7567/fact/0/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/41b13dff061b4393> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5aa83fa3c8ae7567/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Human oversight: audit trails for prompts, retrieved sources, model outputs and tool calls; review workflows for problematic answers; escalation paths for uncertain, non-supported or risky content; user-facing disclaimers and scope boundaries; monitoring of anomalies, hallucination risk and source gaps; analytics identifying where knowledge or prompts need improvement. Pharmaceutical AI governance (EMA mindset, though WAP is an HCP-facing knowledge/engagement assistant, not a diagnostic tool): define intended and out-of-scope use, validate source quality and retrieval performance, test with domain experts, document model/data/prompt behavior, monitor post-deployment, controlled release processes. Layered guardrails: PII/patient data detection and masking, prompt injection and jailbreak protection, hallucination detection and source coverage checks, out-of-scope query detection, medical-risk and compliance-risk flags, content filters adapted to pharmaceutical vocabulary without blocking legitimate medicine names, adverse-event detection logic if in scope." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5aa83fa3c8ae7567/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5aa83fa3c8ae7567/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/41b13dff061b4393> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5aa83fa3c8ae7567/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Business value: scalable HCP engagement via 24/7 digital access to approved Polpharma knowledge, complementing physical representative interactions without relying solely on headcount or geography; faster access to trusted product, medical, educational and promotional content through natural-language questions instead of navigating multiple systems; consistent and traceable communication thanks to source-grounded responses enabling review, audit and continuous improvement; data-driven content strategy." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

