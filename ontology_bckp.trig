    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-3ed2b9b4b2daee19/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "For list-style ICD-10 scenarios, use template-based answer composition: a small model or predefined pattern generates a short Polish introduction and the retrieved product list is appended directly, instead of passing the full list as long context to the main LLM; implement a dedicated ATC retrieval tool separate from the ICD-10 tool with routing of ATC vs ICD-10 questions; validate routing so similar questions do not yield inconsistent results." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-3ed2b9b4b2daee19/fact/1> a prov:Collection ;
