    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-818f495c50ce45eb/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-818f495c50ce45eb/fact/0/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/cbf0b9ce6f386fcc> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-818f495c50ce45eb/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Azure-native deployment principles: separate dev/test/prod environments, Infrastructure-as-Code for reproducible provisioning, managed identities and Key Vault for secrets, private network patterns where required, observable runtime and traceable LLM interactions, controlled access to data sources and logs, documented APIs for portal or widget integration. Modular growth platform supporting incremental extension via modules: base pharmaceutical knowledge platform, ChPL/product characteristics knowledge base, medical articles, calculators, adverse reactions and contraindications, reimbursement, drug availability (if source access confirmed), treatment guidelines (if approved sources available), eDetailing module and eDetailing administration, analytics and quality monitoring." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-818f495c50ce45eb/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-818f495c50ce45eb/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/cbf0b9ce6f386fcc> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-818f495c50ce45eb/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "WAP operates in a medical and pharmaceutical information context, so it must be designed with safety, compliance and auditability from the start (Responsible AI, safety-by-design). Scope boundaries: WAP does not diagnose, replace clinical judgment or independently interpret clinical cases; it provides source-grounded information and access to approved knowledge. Human oversight per EU AI Act: audit trails for prompts, retrieved sources, model outputs and tool calls; review workflows for problematic answers; escalation paths for uncertain or risky content; user-facing disclaimers; monitoring of anomalies, hallucination risk and source gaps; analytics identifying where knowledge or prompts need improvement." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

