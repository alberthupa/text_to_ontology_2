    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-f3215d7e74f90393/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-f3215d7e74f90393/fact/0/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/7fde6b1ff7918251> .

    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-f3215d7e74f90393/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Using the authorized doctor's location context, the system should indicate whether and where a drug is available to the patient; when a drug is unavailable it should suggest alternative drugs currently available in pharmacies and wholesalers; for reimbursed drugs it should display reimbursement information and rules and provide a ready, NFZ-compliant reimbursement justification template to paste; for drugs with parameter-dependent dosing it should give access to dose calculators, link to the relevant calculator when presenting results, and in dialogue collect required input parameters, ask for missing ones and return the computed dose." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-b06762aea0d04870> .

    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-f3215d7e74f90393/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-f3215d7e74f90393/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/7fde6b1ff7918251> .

    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-f3215d7e74f90393/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Drug availability hints aim to improve the visit experience and prevent patients returning to the doctor because prescribed products could not be bought. Reimbursement rules set by the Ministry of Health change cyclically; doctors face high financial penalties for incorrectly prescribing reimbursed drugs, and keeping up with rules distracts them from their core work. A ready reimbursement justification speeds up work and reduces risk of error and penalty." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-b06762aea0d04870> .

