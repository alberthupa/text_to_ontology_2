    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5dc438ed8bda522c/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5dc438ed8bda522c/fact/0/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/ce98d9ae330c08da> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5dc438ed8bda522c/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "WAP extends Polpharma's digital ecosystem from a content portal into an interactive, conversational knowledge interface, so HCPs no longer need to manually search product databases, articles, calculators, reimbursement data and promotional materials. Strategic ambition: a scalable AI-native channel that complements traditional medical representative interactions, improves access to consistent medical information, and generates actionable insight into HCP information needs. Commercial role: digital medical representative and eDetailing assistant." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5dc438ed8bda522c/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5dc438ed8bda522c/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/ce98d9ae330c08da> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5dc438ed8bda522c/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Primary users: physicians, pharmacists and other healthcare professionals. Primary use case: fast, source-grounded access to pharmaceutical and medical information. Polish-first experience optimized for Polish medical terminology. Channels: web widget / portal integration and standalone web application, depending on deployment scope." ;
        rdf:predicate fact:project-summary ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5dc438ed8bda522c/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5dc438ed8bda522c/fact/2/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/ce98d9ae330c08da> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5dc438ed8bda522c/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Natural-language interface over approved pharmaceutical knowledge sources covering product information and characteristics, active substances, contraindications and adverse reactions, interactions (where data sources/integrations available), reimbursement information, medical articles and educational materials, clinical calculators via integration, and contextual eDetailing materials for selected Polpharma products. Every medical/product answer must be traceable to source material (source grounding as core trust mechanism). Azure-based deployment in Polpharma-provided cloud; modular, API-first, cloud-native architecture using managed Azure services; Graph RAG and hybrid retrieval. Governance emphasis: Responsible AI, AI Act awareness, auditability, human oversight, controlled knowledge grounding." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

