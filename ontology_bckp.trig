    <http://example.org/text-ontology/statement/a498c4825ae111573ea232835193d83df82f40e4304aeec4e888ac8ad497a6cd> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/112e3b8a60567a0b308b02f613ca40652a4855b9862de7ad272a9a1aee20d01f> ;
        rdf:object "Use small specialized tools (e.g. a list intersection tool accepting two or more retrieved result lists and returning their intersection) and decompose complex medical questions into smaller retrieval steps that can be tested and combined, instead of forcing the LLM to solve everything in one large Gremlin query." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-28b154549e870b67> .

    <http://example.org/text-ontology/statement/a4bc7670369e8a4235cc6d4c4fb04910899d367bb974adba5a7762ee147b0020> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/112e3b8a60567a0b308b02f613ca40652a4855b9862de7ad272a9a1aee20d01f> ;
        rdf:object "A dedicated backlog epic is created for the retrieval optimization initiative; stories on dedicated tools, Gremlin fallback, AI Search replacement, buttons/clarifications, latency, and evaluation are linked to it; scattered existing stories are consolidated; the epic reflects the plan discussed in the workshop rather than isolated technical changes." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-28b154549e870b67> .

