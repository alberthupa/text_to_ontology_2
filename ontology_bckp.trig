    <http://example.org/text-ontology/candidate/doc-d713d0d4a0618548/win-85c51ce8c009ea19/fact/8/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/5c6394e1e79162de4821721403f4deca34ee7eb9f770e28063bf62d48abcf98b> ;
        rdf:object "Build first draft of data access architecture (requested by Arnab): pinpoint source data points; describe each source by business meaning, structure, access path, ownership and workflow role; capture policy/usage assumptions; define whether each source is queried directly, referenced via metadata or supplied by a managed pipeline. User-facing docs in SharePoint, workflow-facing documents in blob storage. Structured formulation data path cdl stc prod -> gold_stc." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-d713d0d4a0618548/p-g-text-to-graph-poc> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-d713d0d4a0618548> .

