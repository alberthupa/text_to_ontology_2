        rdf:object "Doctors use the assistant to ask which drugs can be used for a given disease; drug-recommendation scenarios should operate on standardized medical classifications (ICD-10) and deliver reliable answers." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
