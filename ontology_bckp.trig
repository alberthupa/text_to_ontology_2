    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5fe616a0fc648fec/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5fe616a0fc648fec/fact/0/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/30b84c58049b2b2e> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5fe616a0fc648fec/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Graph RAG with hybrid retrieval: graph-based retrieval for relationship-heavy, structured or quantitative scenarios; AI Search / semantic retrieval for content-heavy, qualitative, article-like or document-fragment scenarios; dedicated tools for repeatable business scenarios (disease-to-drug mapping, ICD-10 based interpretation, reimbursement lookup, structured product queries). Reduces dependency on free-form LLM reasoning and improves latency, explainability and control. Every medical or product answer must be traceable to source material (source grounding as core trust mechanism). Polish medical NLP layer for entity recognition, terminology normalization, inflection/synonymy, intent classification and clarification." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5fe616a0fc648fec/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5fe616a0fc648fec/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/30b84c58049b2b2e> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5fe616a0fc648fec/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Conversational pharmaceutical knowledge access covering product information and characteristics, active substances, contraindications and adverse reactions, interactions (where data sources are available), reimbursement information, medical articles and educational materials, clinical calculators via integration, and contextual eDetailing materials for selected Polpharma products; also acts as a digital medical representative via eDetailing." ;
        rdf:predicate fact:project-summary ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

