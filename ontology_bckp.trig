            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Primary users: physicians, pharmacists and other healthcare professionals. Primary use case: fast, source-grounded access to pharmaceutical and medical information. Polish-first experience optimized for Polish medical terminology. Channels: web widget / portal integration and standalone web application, depending on deployment scope." ;
        rdf:predicate fact:project-summary ;
