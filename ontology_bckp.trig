    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/0/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/05b0618ae22fb77d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Add non-streaming endpoint support for article/video retrieval responses: non-streaming response structure aligned with the streaming endpoint where applicable, result fields compatible with frontend expectations, supports article and video result types, tested locally and/or on dev, existing streaming endpoint behavior not broken, result-label mapping handled consistently." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/05b0618ae22fb77d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Introduce hybrid search for article/video retrieval combining semantic/vector and keyword signals, configurable through existing search settings, keeping similarity threshold and result-count configuration, with retrieval quality compared against the current approach on representative queries, settings documented for future tuning, and controlled rollout for selected retrieval flows if not enabled globally." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/2/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/05b0618ae22fb77d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Review and improve the similar-question retrieval strategy: confirm whether it uses vector, keyword, hybrid search and/or reranking, document known quality concerns, propose improvement options such as hybrid search or semantic reranking, identify at least one weak scenario, and recommend whether to implement improvements now or defer; no production behavior changed unless separately approved." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-1989dfbfdcf3a9eb/fact/3> a prov:Collection ;
