    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-ef361ad45679c15c/fact/3/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Largest Polish pharmaceutical company and long-standing trusted partner for patients, doctors, pharmacists and business partners; its professional digital presence includes PolpharmaDlaCiebie.pl, a portal for doctors with medical knowledge, video lectures, product information and educational materials." ;
        rdf:predicate fact:client-description ;
        rdf:subject entity:polpharma ;
