        rdf:object "Field values returned from Graph or Search include human-readable field descriptions (semantic model) so the answer-generation step can correctly interpret coded or abbreviated fields such as flags and status indicators; returned data is accompanied by context explaining each relevant field, and raw technical field values are not presented as user-facing medical explanations." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-28b154549e870b67> .

    <http://example.org/text-ontology/statement/abae52cc87aff4d8d24f3cad3fa0dad438d94aeec6af75b402b49de7b6e01196> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/112e3b8a60567a0b308b02f613ca40652a4855b9862de7ad272a9a1aee20d01f> ;
        rdf:object "Design high-level scenario routing for drug properties: the routing layer detects when a user asks about a drug property, determines which property or field is needed where possible, invokes the AI Search-based drug-property retrieval tool for supported cases, and avoids excessively narrow low-level scenarios when a higher-level scenario is more manageable, so the system answers using the most appropriate drug fields instead of overusing Graph retrieval." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-28b154549e870b67> .

