    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-c2c6863603ed8ec9/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Asystent Leków (drug assistant) providing drug information to doctors: drug-drug interactions, suggested auxiliary questions to ask the patient before prescribing, tests accompanying drug application (before, during, after), key information for the patient (application, expected time to effect, side effects), and drug availability based on the authorised doctor's location." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-b06762aea0d04870> .

