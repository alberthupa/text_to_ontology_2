    <http://example.org/text-ontology/candidate/doc-28b154549e870b67/win-5099db275779855a/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/112e3b8a60567a0b308b02f613ca40652a4855b9862de7ad272a9a1aee20d01f> ;
        rdf:object "Dedicated tool accepting a condition or ICD-10 input that returns drugs that should not be used in that context, using a predefined Graph query instead of dynamic Gremlin generation by the LLM; intent detection routes contraindication-style questions to the tool; a combined tool for 'drug for disease but not with condition' returns drugs usable for one disease while excluding those contraindicated for another condition." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-28b154549e870b67> .

