    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-22ceb3a77ae15a06/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Implement a dedicated ATC retrieval tool separate from the ICD-10 retrieval tool that retrieves products for a given ATC class/group; route ATC-related questions to the ATC tool and ICD-10 condition questions to the ICD-10 tool; validate routing with a test set of ICD-10, ATC and ambiguous therapeutic-area queries, document coverage differences (ATC drug-class oriented vs. broader ICD-10 product mappings), adjust routing logic on repeated misclassification, handle ambiguous cases per agreed rules, and document final routing behavior without reducing quality of existing ICD-10 scenarios." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

