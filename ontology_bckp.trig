    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-769c8479e433c36c/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Ingest Vimeo transcriptions via the Vimeo SDK/API using only the active text track version; detect and update indexed version when the active transcript changes; skip and log videos without transcripts; keep ingestion script compatible with the current article/video indexing pipeline." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
