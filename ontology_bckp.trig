    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-04aa7cc8f65bb1fe/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Dawkowanie leków: dla leków wymagających obliczenia dawki system wskazuje link do niezbędnego kalkulatora; w interfejsie dialogowym zbiera wymagane parametry wejściowe, dopytuje o brakujące i podaje wyliczoną wartość dawkowania. Sugestia Lingaro: ze względu na ryzyko pomyłki przy odczycie parametrów, przekierować lekarza do kalkulatora z wynikiem i wprowadzonymi parametrami, co umożliwia prostą modyfikację i optyczną weryfikację." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-b06762aea0d04870> .

    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-04aa7cc8f65bb1fe/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-04aa7cc8f65bb1fe/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/0d70d68ce5b6d361> .

    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-04aa7cc8f65bb1fe/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/ed25cb22801a6ac42cd65e43354c24eb05e78747eb55b6c432d0cbfa19c8b015> ;
        rdf:object "Historia rozmów: system zapisuje jednostki chorobowe oraz leki, o których lekarz poszukiwał informacji; wysyła powiadomienia o nowych terapiach/lekach związanych ze schorzeniem (z przekierowaniem do materiału źródłowego) oraz powiadomienia o zmianach w zasadach refundacji leków, którymi lekarz był zainteresowany." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-b06762aea0d04870> .

    <http://example.org/text-ontology/candidate/doc-b06762aea0d04870/win-04aa7cc8f65bb1fe/fact/2> a prov:Collection ;
