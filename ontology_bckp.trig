    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-6ca4fd86141d4701/fact/4/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Polpharma requires additional metrics for assistant behavior monitoring; intermittent DBAP/Farmindex source-system instability may need to be explained to Polpharma; the product UI is in Polish and article/video labels should feel coherent to end users." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

