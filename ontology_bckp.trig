        rdf:object "Polpharma analytics stakeholders want assistant-generated article links to include configurable query parameters so Polpharma's existing web analytics system can attribute article clicks originating from the assistant (WAP)." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
