    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-36400cb872929cbd/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-36400cb872929cbd/fact/0/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/fa18623d2c8975ed> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-36400cb872929cbd/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Wirtualny Asystent Polpharmy is an AI-native knowledge and engagement platform for healthcare professionals, positioned not as a chatbot but as a controlled digital interface between Polpharma's medical knowledge ecosystem and the healthcare professional community." ;
        rdf:predicate fact:project-summary ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-36400cb872929cbd/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-36400cb872929cbd/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/fa18623d2c8975ed> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-36400cb872929cbd/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Business value: faster access to trusted information (HCPs ask questions naturally instead of navigating multiple systems; reduced friction accessing product, medical, educational and promotional content); consistent and traceable communication (source-grounded responses reduce inconsistent messaging, traceability enables review, audit and improvement); data-driven content strategy via conversation analytics (what doctors ask, missing content, answers needing improvement, which eDetailing materials generate engagement); reusable AI platform for future Polpharma AI initiatives (new knowledge sources, therapeutic areas, agentic workflows, richer analytics)." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-36400cb872929cbd/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-36400cb872929cbd/fact/2/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/fa18623d2c8975ed> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-36400cb872929cbd/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Differentiators vs typical chatbots: dynamic retrieval over controlled pharmaceutical knowledge sources; source-grounded answers with citations and traceability; Polish-first medical language handling; hybrid retrieval combining graph, semantic search and dedicated tools; observable prompts, tool calls, sources and model behavior; modular platform for eDetailing, analytics, calculators and future modules; responsible AI governance." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

