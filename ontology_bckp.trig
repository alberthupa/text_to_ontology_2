    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-52c5fbccd6ee3c47/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-52c5fbccd6ee3c47/fact/0/statement/0> ;
