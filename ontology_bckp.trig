        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "End users ask about medicines for conditions (ICD-10) and about drug groups (ATC); responses must be understandable and grammatically correct in Polish, preserve retrieval source/result correctness, and be covered by regression tests." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

