    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-5992e93270dcb778/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Azure-native deployment aligned with Polpharma's Azure environment and security expectations: separate dev/test/prod environments, Infrastructure-as-Code provisioning, managed identities and Key Vault for secrets, private network patterns where required, observable runtime with traceable LLM interactions, controlled access to data sources and logs, documented APIs for portal or widget integration. Core stack: Azure OpenAI; LangChain/LangGraph orchestration; LiteLLM gateway; Azure AI Search, vector search and graph/Gremlin retrieval; Python API-first backend with web frontend integration; PostgreSQL, Cosmos DB, Redis, ClickHouse data layer; Langfuse, Application Insights, Log Analytics observability; Terraform and Azure DevOps CI/CD." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

