    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-ef361ad45679c15c/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-ef361ad45679c15c/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/a3d5c1b03a1f290b> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-ef361ad45679c15c/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Polpharma, the largest Polish pharmaceutical company, already runs PolpharmaDlaCiebie.pl, a content portal for doctors. WAP extends this ecosystem into an interactive conversational knowledge interface so HCPs no longer need to manually search product databases, articles, calculators, reimbursement data and promotional materials. The strategic ambition is a scalable AI-native channel complementing medical representative interactions, improving access to consistent medical information and generating insight into HCP information needs." ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-ef361ad45679c15c/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-ef361ad45679c15c/fact/2/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/a3d5c1b03a1f290b> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-ef361ad45679c15c/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
        rdf:object "Conversational AI assistant grounded in controlled, Polpharma-approved sources; not a diagnostic system; helps physicians and pharmacists navigate approved pharmaceutical knowledge, educational content and product materials while maintaining boundaries around medical claims, citations, compliance and human oversight." ;
        rdf:predicate fact:solution-direction ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2bb24fba21bae0a2> .

    <http://example.org/text-ontology/candidate/doc-2bb24fba21bae0a2/win-ef361ad45679c15c/fact/3> a prov:Collection ;
