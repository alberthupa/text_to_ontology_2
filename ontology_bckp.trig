    <http://example.org/text-ontology/statement/a57c1206ae40b5d99e1c342ff38ab23886209149a8b47fb7d3b9359e34f93191> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/0f65078739c25bec9198eb3782a929be409f564b9bc2520d36c5c5b53aab83e6> ;
