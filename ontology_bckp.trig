    <http://example.org/text-ontology/candidate/doc-1c4e4cfc23386b8d/win-4032020ec4df48a1/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/672270f8509323044e0497f31c149b87c620753d5fc1f8b07de8aa3bf9e6712e> ;
        rdf:object "Pharma Assistant project for Polpharma: system ingesting Farmindex pharmaceutical product data into Postgres, matching products with DBAP packshots/entities via BLOZ identifier, flagging Polpharma vs non-Polpharma products, with a graph (Gremlin) component." ;
        rdf:predicate fact:project-summary ;
        rdf:subject entity:pharma-assistant ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-1c4e4cfc23386b8d> .

