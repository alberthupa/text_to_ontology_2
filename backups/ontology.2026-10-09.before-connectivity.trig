    <http://example.org/text-ontology/candidate/doc-2a6242565ea28501/win-be435ee918ac2d20/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/7947cee29094ddc189045e9721b2dc645df96610a28c509ec1b0934098393de5> ;
        rdf:object "Conversational assistants giving business users natural-language access to enterprise data and knowledge, combining NL2SQL over structured data (data warehouses & semantic models, relational databases, governed analytical platforms) and RAG over unstructured knowledge (PDFs, policies, SOPs, documents, presentations, contracts, knowledge repositories)" ;
        rdf:predicate fact:offer-definition ;
        rdf:subject entity:talk-to-data ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2a6242565ea28501> .

    <http://example.org/text-ontology/candidate/doc-2a6242565ea28501/win-be435ee918ac2d20/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2a6242565ea28501/win-be435ee918ac2d20/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/7ec447193ac04574> .

    <http://example.org/text-ontology/candidate/doc-2a6242565ea28501/win-be435ee918ac2d20/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/7947cee29094ddc189045e9721b2dc645df96610a28c509ec1b0934098393de5> ;
        rdf:object "Talk-to-Data Assistants answer KPI, trend, drill-down and performance questions via NL2SQL (e.g. 'What were total sales in Germany in Q1 vs. last year?') and policy, process, document search/summarization and narrative questions via RAG (e.g. 'What does our policy say about discount limits in Europe?'), available in text and voice modes" ;
        rdf:predicate fact:offer-summary ;
        rdf:subject entity:talk-to-data ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2a6242565ea28501> .

