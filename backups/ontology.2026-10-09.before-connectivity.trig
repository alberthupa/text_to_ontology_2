    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Assign stores to specific visit schedules (e.g. MWF, TuTh) and plan daily routes to minimize the number of merchandisers needed and travel distance, with restrictions on visit frequency, duration, which stores can share a route, max travel distance and max working time" ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:merchandiser-resource-allocation ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-e68fe065f017f95e> .

    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/1> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/1/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/fc3c02fc351c4288> .

    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Minimize the number of merchandisers required and total travel distance while meeting every store's visit frequency and duration requirements" ;
        rdf:predicate fact:business-need ;
        rdf:subject entity:merchandiser-resource-allocation ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-e68fe065f017f95e> .

    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/2/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/fc3c02fc351c4288> .

    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Two-stage optimization: Model #1 (store schedule assignment) uses binary variables indicating whether a store is assigned to a schedule plus auxiliary variables, requires every store to be assigned to a schedule, and balances daily demand spikes, political constraints, store proximity and schedule fitness; its output (stores to visit per day) feeds Model #2 (daily route optimization), a vehicle routing model minimizing total travel time/distance and number of merchandisers, with total time per merchandiser (travel + in-store) capped at 8 hours and political/route-compatibility constraints respected" ;
        rdf:predicate fact:proposed-solution ;
        rdf:subject entity:merchandiser-resource-allocation ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-e68fe065f017f95e> .

