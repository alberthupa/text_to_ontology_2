        rdf:object "Natural-language interface over enterprise data and knowledge combining NL2SQL over structured data and RAG over unstructured documents. How it works: 1) Ask in natural language; 2) Understand intent; 3) Query the right sources (structured data, documents, or both); 4) Return the answer (summary, metric, chart, explanation, citation)" ;
        rdf:predicate fact:offer-definition ;
        rdf:subject entity:talk-to-data ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-2a6242565ea28501> .

