    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-476ce492fae6a052/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Total time per merchandiser (travel + in-store) limited to 8h maximum; political constraints respected; for stores with visit durations >= 2h, travel time up to 30 min is included as part of the visit time; if route time < 8 hours, the extra merchandiser time is spread equally across all stores in the route, creating overdeployment" ;
        rdf:predicate fact:assumptions ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-e68fe065f017f95e/review/win-476ce492fae6a052/e1> ;
