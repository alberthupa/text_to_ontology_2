    <http://example.org/text-ontology/candidate/doc-6b061eb3d8160746/win-b57e4bc97d27f9b4/fact/11> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-6b061eb3d8160746/win-b57e4bc97d27f9b4/fact/11/statement/0> ;
