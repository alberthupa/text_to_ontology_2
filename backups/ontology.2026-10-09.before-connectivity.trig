    <http://example.org/text-ontology/candidate/doc-6b061eb3d8160746/win-464eb4f0fb861387/fact/5/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/139102c7bcfb58da57936bc827dad9d497ad5319b67801fbe6234fcf566715d7> ;
        rdf:object "Five-phase methodology for controlled risk and rapid value delivery: 1 Discover – Current State Assessment (audit tools, processes & data flows; map pain points to technical requirements); 2 Design – Solution Architecture (define routing engine, APIs, territory model & UX for GTM and frontliners); 3 Build – MVP Development (core routing: updated maps, dynamic adjustments, territory rules, analytics); 4 Pilot – Controlled Validation (deploy to one commercial unit; measure KPIs, gather feedback, iterate); 5 Scale – Nationwide Rollout (extend to all 11 commercial units with advanced optimisation features)" ;
        rdf:predicate fact:delivery-shape ;
        rdf:subject entity:routing-optimization-platform-proposal ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-6b061eb3d8160746> .

