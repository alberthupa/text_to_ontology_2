        rdf:object "Modular, backend-driven routing optimization platform supporting operational and planning use cases, with consumption layer (Frontliner Tools, Go-to-Market Tool, Dashboards), Core Routing Platform, and supporting data ingestion, API/integration and monitoring layers" ;
        rdf:predicate fact:proposal-summary ;
        rdf:subject entity:routing-optimization-platform-proposal ;
