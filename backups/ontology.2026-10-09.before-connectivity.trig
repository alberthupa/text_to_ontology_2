    entity:merchandiser-resource-allocation-tool a onto:Entity,
            class:project,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Merchandiser Resource Allocation tool" ;
        fact:assumptions "A store can have both stationary merchandisers (visits 6 days a week / 8 hours a day) and roving merchandisers (visit frequency < 6 days or visit duration < 8 hours)",
            "FTE requirements depend on business rules provided by the client: visit frequency based on sales volume (P12) and visit duration based on product variety (P12)",
            "Merchandiser daily work hours <= 8",
            "Overdeployment possible if sum of store visits on a route < 8 hours; leftover time spread across all stores in a route",
            "Political constraints define which account groups can be visited together",
            "Sales regions as defined by the client differ from official administrative boundaries",
            "Travel times are proportional to distances and based on the speed limits of the roads" ;
        fact:business-need "Reduce merchandising cost while improving store coverage and merchandiser productivity" ;
        fact:delivery-shape "Two-layer solution: Input Layer (Business Rules - visit frequency and duration; Political Constraints - which stores can be visited together; Store Mapping - store locations and distance/time matrices) and Optimization Layer (optimization models, starting with Store Schedule Assignment)" ;
        fact:project-summary "Merchandiser resource allocation tool that analyzes business restrictions, proximity, sales data and account information to generate optimized merchandiser deployment plans and routes" ;
        fact:proposed-solution "Store Schedule Assignment is a mixed integer programming model that determines which days each store is visited while minimizing headcount",
            "Store mapping computes shortest paths between all pairs of store locations (latitude & longitude) within a region using OpenStreetMap data and the osmnx Python library, with a buffer added to avoid cutting off roads; resulting distance and time matrices feed the optimization models" ;
        fact:scope "Inputs analyzed: business restrictions, proximity, sales data, account information" ;
        fact:solution-direction "Optimization-based planning: input layer feeds distance/time matrices and business constraints into mathematical optimization models to produce deployment plans and routes" ;
        onto:kind "Project" ;
        relation:project-uses-technology entity:mixed-integer-programming,
            entity:openstreetmap,
            entity:osmnx,
            entity:python ;
        rdfs:comment "Tool that analyzes business restrictions, proximity, sales data and account information to generate optimized deployment plans and routes for merchandisers, reducing cost and improving coverage and productivity" ;
        skos:altLabel "Merchandiser deployment planning tool",
            "Merchandiser route optimization tool" ;
        skos:prefLabel "Merchandiser Resource Allocation tool" .

