    <http://example.org/text-ontology/candidate/doc-2a6242565ea28501/win-be435ee918ac2d20/fact/0> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-2a6242565ea28501/win-be435ee918ac2d20/fact/0/statement/0> ;
