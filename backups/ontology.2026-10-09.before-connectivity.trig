        prov:hadMember <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/3/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/fc3c02fc351c4288> .

