        rdf:object "Store-to-schedule assignment model and daily vehicle-routing model for merchandiser visits, implemented with the FICO Xpress Python library" ;
        rdf:predicate fact:scope ;
        rdf:subject entity:merchandiser-resource-allocation ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-e68fe065f017f95e> .

