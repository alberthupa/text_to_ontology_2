    entity:merchandiser-route-optimization-philippines a onto:Entity,
            class:project,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Merchandiser Route Optimization (Philippines)" ;
        fact:assumptions "Store FTE = total sum of hours to visit stores within a region / 48; Merchandiser (Roving) FTE = total routes for a region / 6; merchandisers can work a maximum of 6 days a week; Headcount Efficiency = % of a roving merchandiser FTE covered by one roving headcount; PC adherence = % of full schedules (clustered routes) that do not violate political constraints" ;
        fact:delivery-evidence "CL: HC Efficiency 0.86, PC adherence 0.34, FTE savings 42.98%, HC savings 35.03%",
            "EV: HC Efficiency 0.76, PC adherence 0.48, FTE savings 24.73%, HC savings 12.15%",
            "GMA: HC Efficiency 0.95, PC adherence 0.67, FTE savings 43.82%, HC savings 41.30%",
            "NL: HC Efficiency 0.74, PC adherence 0.45, FTE savings 37.86%, HC savings 23.39%",
            "NM: HC Efficiency 0.72, PC adherence 0.60, FTE savings 19.96%, HC savings 1.14%",
            "Power BI sample (GMA Friday overdeployment view): Weekly Stores FTE 20.68; Roving FTE Proposed 27.20, Existing 6.53; all GMA Friday routes flagged as overdeployed by more than 2 hours",
            "Power BI sample (specific merchandiser view): Weekly Stores FTE 1.30; Roving FTE Proposed 2.01, Existing 0.71; Headcount Efficiency 100.00%",
            "SEL: HC Efficiency 0.83, PC adherence 0.61, FTE savings 37.26%, HC savings 27.15%",
            "SM: HC Efficiency 0.76, PC adherence 0.55, FTE savings 29.01%, HC savings 17.08%",
            "SWL: HC Efficiency 0.77, PC adherence 0.49, FTE savings 41.60%, HC savings 27.25%",
            "WV: HC Efficiency 0.78, PC adherence 0.38, FTE savings 37.47%, HC savings 25.42%" ;
        fact:delivery-shape "Infrastructure architecture with FICO as the optimization solver and a Power BI presentation layer for routes, merchandiser schedules and coverage metrics" ;
        fact:project-summary "Route stitching model that clusters store visits into roving merchandiser routes per Philippine region; outputs roving headcount (number of merchandisers needed to cover all routes), measured by HC Efficiency, PC adherence, FTE savings and HC savings" ;
        fact:proposed-solution "Route stitching optimization model solved with FICO; outputs roving headcount and clustered weekly schedules; Power BI dashboard shows all routes, routes by day of week, routes per merchandiser and extra coverage opportunities" ;
        fact:scope "Nine Philippine regions (CL, EV, GMA, NL, NM, SEL, SM, SWL, WV); roving merchandiser route clustering and headcount sizing" ;
        fact:solution-direction "Use Power BI to identify extra coverage opportunities as routes with overdeployment greater than 2 hours" ;
        fact:target-context "Philippines regions: CL, EV, GMA, NL, NM, SEL, SM, SWL, WV (map also highlights GMA, Palawan, Mindanao)" ;
        onto:kind "Project" ;
        relation:project-uses-technology entity:fico-xpress,
            entity:power-bi ;
        rdfs:comment "Route stitching / clustering engagement that optimizes roving merchandiser routes across Philippine regions, producing roving headcount, FTE and headcount savings, with results presented in a Power BI dashboard and solved with FICO" ;
        skos:altLabel "Route stitching model",
            "Roving merchandiser routing" ;
        skos:prefLabel "Merchandiser Route Optimization (Philippines)" .

    entity:merchandiser-route-optimization-proposal-fico-as-a-solver a onto:Entity,
            class:proposal,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Merchandiser Route Optimization Proposal (FICO as a solver)" ;
        fact:delivery-evidence "Sample Power BI dashboard showing Weekly Stores FTE of 20.68 and Roving (Merchandiser) FTE of 27.20 proposed versus 6.53 existing, and GMA Friday routes with overdeployment greater than 2 hours" ;
        fact:proposed-solution "Azure-based optimization platform using FICO Xpress as the solver: Snowflake as main data source, Azure Data Factory for additional flat file ingestion, Azure Databricks with bronze/silver/gold data layers and a model store, ADLS Gen2 storage, Azure Logic Apps, client's SharePoint storage, OpenStreetMap API for map data, MLflow, Azure DevOps CI/CD (ADO Repo and Pipelines), Azure Active Directory for developer and MLflow user access, vNet with public and private subnets, Key Vault, Log Analytics and Application Insights for monitoring, with Power BI reports (POC/MVP) as the reporting layer" ;
        fact:scope "Infrastructure architecture (Slide 28) covering data ingestion, data layers, optimization solver, model store, CI/CD, identity, monitoring and Power BI reporting; sample dashboard scope includes GMA (Greater Manila Area) Friday routes with overdeployment > 2 hours" ;
        fact:solution-direction "Optimization of merchandiser/roving routes and store coverage using FICO as a solver, surfacing extra coverage opportunities (routes with overdeployment > 2 hours) and FTE metrics in Power BI dashboards" ;
        fact:source-artifact-type "Proposal presentation slide deck (infrastructure architecture on Slide 28, sample Power BI dashboard)" ;
        onto:kind "Proposal" ;
        relation:proposal-uses-technology entity:adls-gen2,
            entity:application-insights,
            entity:azure,
            entity:azure-active-directory,
            entity:azure-data-factory,
            entity:azure-devops,
            entity:azure-key-vault,
            entity:azure-log-analytics,
            entity:azure-logic-apps,
            entity:azure-virtual-network,
            entity:databricks,
            entity:fico-xpress,
            entity:mlflow,
            entity:openstreetmap,
            entity:power-bi,
            entity:sharepoint,
            entity:snowflake ;
        rdfs:comment "Proposal for an optimization solution using FICO Xpress as the solver, with an Azure-based infrastructure architecture (Slide 28) and Power BI dashboards showing route overdeployment and FTE metrics (e.g., GMA Friday routes with overdeployment > 2 hours; Weekly Stores FTE 20.68; Roving FTE proposed 27.20 vs existing 6.53)" ;
        skos:altLabel "Infrastructure Architecture - FICO as a solver",
            "Route optimization proposal" ;
        skos:prefLabel "Merchandiser Route Optimization Proposal (FICO as a solver)" .

    entity:merchandiser-store-visit-routing-and-scheduling-optimization a onto:Entity,
            class:project,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Merchandiser Store Visit Routing and Scheduling Optimization" ;
        fact:assumptions "Store Schedule Assignment constraints: visit frequency, visit duration, and which stores can be visited as part of the same route; decision variables are binary store-to-schedule assignments plus auxiliary variables" ;
        fact:business-need "Minimize the number of merchandisers (headcount) and travel distance needed to visit roving stores while respecting visit frequency, duration, routing and political constraints" ;
        fact:delivery-evidence "Performance Insights report compares existing and proposed FTE store assignments ('What improved?'); Opportunities analysis identifies regions where new stores/outlets can be added with little extra cost ('Where can we add new outlets?')" ;
        fact:project-summary "Optimization solution for merchandiser store visits: maps stores with OpenStreetMap, assigns stores to weekly schedules (MIP), optimizes daily routes (vehicle routing) and builds weekly merchandiser schedules (heuristic), presented via a Power BI dashboard, performance insights and opportunities analysis" ;
        fact:proposed-solution "Store mapping step (Where are the stores?) using OpenStreetMap to compute distance and time matrices; Optimization layer with three models: Store Schedule Assignment (What day(s) to visit each store on?), Daily Route Optimization (How to visit the stores?) and Weekly Schedule Creation (How to allocate merchandisers to routes?); Presentation layer with Power BI Dashboard, Performance Insights report and Opportunities analysis" ;
        fact:scope "Roving stores; store mapping, schedule assignment, daily routing, weekly scheduling, and presentation layer (dashboard filterable by region, store chain, day of week; existing vs proposed FTE store assignments; regions where new outlets can be added at little extra cost)" ;
        fact:solution-direction "Mixed integer programming (via FICO Xpress Python library) for store-to-schedule assignment, vehicle routing model for daily routes, heuristic model for weekly schedules; linear programming chosen as well suited to assignment problems with an objective function and restrictions" ;
        onto:kind "Project" ;
        relation:project-uses-technology entity:fico-xpress,
            entity:mixed-integer-programming,
            entity:openstreetmap,
            entity:power-bi,
            entity:python ;
        rdfs:comment "Optimization solution that maps store locations, assigns stores to weekly visit schedules, optimizes daily routes and builds weekly merchandiser schedules while minimizing headcount, with a Power BI presentation layer" ;
        skos:altLabel "Merchandiser Route Optimization",
            "Store Visit Optimization" ;
        skos:prefLabel "Merchandiser Store Visit Routing and Scheduling Optimization" .

