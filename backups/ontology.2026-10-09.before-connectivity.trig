    <http://example.org/text-ontology/candidate/doc-6b061eb3d8160746/win-464eb4f0fb861387/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/139102c7bcfb58da57936bc827dad9d497ad5319b67801fbe6234fcf566715d7> ;
        rdf:object "Core Routing Platform: External Map Services (maps, traffic, distance matrix, geocoding), Map/Traffic Adapter (provider abstraction), Routing Optimization Engine (route calculation & recalculation), Rules & Constraints Service (territories, feasibility, priorities); plus Data Ingestion & Validation Layer (quality checks, geocoding readiness, refresh orchestration), API & Integration Layer (route plans, updates, execution status, compliance signals), Monitoring & Audit (performance, data quality, route versions)" ;
        rdf:predicate fact:proposed-solution ;
        rdf:subject entity:routing-optimization-platform-proposal ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-6b061eb3d8160746> .

