    <http://example.org/text-ontology/candidate/doc-6b061eb3d8160746/win-b57e4bc97d27f9b4/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/139102c7bcfb58da57936bc827dad9d497ad5319b67801fbe6234fcf566715d7> ;
        rdf:object "GTM Team plans routes centrally, builds CSV files with manual lat-long adjustments per route and uploads/distributes weekly plans to sales reps; Sales Reps (pre-sellers and account developers) receive plans ahead of the working week and execute daily routes; Finance manages revenue and route revenue analysis separately with its own tooling, not integrated with the routing tool" ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:cceap ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-6b061eb3d8160746> .

