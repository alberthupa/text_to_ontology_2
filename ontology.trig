            skos:Concept ;
        rdfs:label "Calendar & Visit Plan" ;
        ns2:approach "Configurable month boundary rule (clean-cut vs ratio-based), visit frequency per store (weekly/bi-weekly/monthly), working week definition (start day, weekend days, holidays), and monthly-to-weekly mapping (effective visit weeks per month)" ;
        ns2:business "Correctly mapping business time (months, weeks, visits) to calendar time is essential for every downstream feature — assortment stability, quantity reconciliation, target tracking, and rep productivity all depend on a shared, market-aware calendar." ;
        ns2:business-value "Correctly mapping business time (months, weeks, visits) to calendar time is essential for every downstream feature — assortment stability, quantity reconciliation, target tracking, and rep productivity all depend on a shared, market-aware calendar." ;
        ns2:complexity "Partial weeks (a calendar month rarely contains exactly 4 full weeks); visit frequencies (weekly, bi-weekly, monthly per store); intra-week patterns (top stores visited Mon/Tue, 60-70% of weekly volume may concentrate in the first 2 days); market-specific working weeks (start day Monday, Sunday or Saturday; differing weekend days)" ;
        ns2:section "5.9" ;
        ns3:kind "Entity" ;
        ns4:feature-of <http://example.org/text-ontology/entity/mondelez-suggested-orders-2-0> ;
        ns4:is-feature-of <http://example.org/text-ontology/entity/mondelez-suggested-orders-2-0> ;
        ns4:part-of <http://example.org/text-ontology/entity/mondelez-suggested-orders-2-0> ;
