    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Two-stage optimization: Model #1 (store schedule assignment) uses binary variables indicating whether a store is assigned to a schedule plus auxiliary variables, requires every store to be assigned to a schedule, and balances daily demand spikes, political constraints, store proximity and schedule fitness; its output (stores to visit per day) feeds Model #2 (daily route optimization), a vehicle routing model minimizing total travel time/distance and number of merchandisers, with total time per merchandiser (travel + in-store) capped at 8 hours and political/route-compatibility constraints respected" ;
