    entity:merchandiser-resource-allocation-tool a onto:Entity,
            class:project,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Merchandiser Resource Allocation tool" ;
        fact:assumptions "A store can have both stationary merchandisers (visits 6 days a week / 8 hours a day) and roving merchandisers (visit frequency < 6 days or visit duration < 8 hours)",
            "FTE requirements depend on business rules provided by the client: visit frequency based on sales volume (P12) and visit duration based on product variety (P12)",
            "Merchandiser daily work hours <= 8",
            "Overdeployment possible if sum of store visits on a route < 8 hours; leftover time spread across all stores in a route",
            "Political constraints define which account groups can be visited together",
            "Sales regions as defined by the client differ from official administrative boundaries",
            "Travel times are proportional to distances and based on the speed limits of the roads" ;
        fact:business-need "Reduce merchandising cost while improving store coverage and merchandiser productivity" ;
        fact:delivery-shape "Two-layer solution: Input Layer (Business Rules - visit frequency and duration; Political Constraints - which stores can be visited together; Store Mapping - store locations and distance/time matrices) and Optimization Layer (optimization models, starting with Store Schedule Assignment)" ;
        fact:project-summary "Merchandiser resource allocation tool that analyzes business restrictions, proximity, sales data and account information to generate optimized merchandiser deployment plans and routes" ;
        fact:proposed-solution "Store Schedule Assignment is a mixed integer programming model that determines which days each store is visited while minimizing headcount",
            "Store mapping computes shortest paths between all pairs of store locations (latitude & longitude) within a region using OpenStreetMap data and the osmnx Python library, with a buffer added to avoid cutting off roads; resulting distance and time matrices feed the optimization models" ;
        fact:scope "Inputs analyzed: business restrictions, proximity, sales data, account information" ;
        fact:solution-direction "Optimization-based planning: input layer feeds distance/time matrices and business constraints into mathematical optimization models to produce deployment plans and routes" ;
        onto:kind "Project" ;
        relation:project-uses-technology entity:mixed-integer-programming,
            entity:openstreetmap,
            entity:osmnx,
            entity:python ;
        rdfs:comment "Tool that analyzes business restrictions, proximity, sales data and account information to generate optimized deployment plans and routes for merchandisers, reducing cost and improving coverage and productivity" ;
        skos:altLabel "Merchandiser deployment planning tool",
            "Merchandiser route optimization tool" ;
        skos:prefLabel "Merchandiser Resource Allocation tool" .

    entity:merchandiser-route-optimization-philippines a onto:Entity,
            class:project,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Merchandiser Route Optimization (Philippines)" ;
        fact:assumptions "Store FTE = total sum of hours to visit stores within a region / 48; Merchandiser (Roving) FTE = total routes for a region / 6; merchandisers can work a maximum of 6 days a week; Headcount Efficiency = % of a roving merchandiser FTE covered by one roving headcount; PC adherence = % of full schedules (clustered routes) that do not violate political constraints" ;
        fact:delivery-evidence "CL: HC Efficiency 0.86, PC adherence 0.34, FTE savings 42.98%, HC savings 35.03%",
            "EV: HC Efficiency 0.76, PC adherence 0.48, FTE savings 24.73%, HC savings 12.15%",
            "GMA: HC Efficiency 0.95, PC adherence 0.67, FTE savings 43.82%, HC savings 41.30%",
            "NL: HC Efficiency 0.74, PC adherence 0.45, FTE savings 37.86%, HC savings 23.39%",
            "NM: HC Efficiency 0.72, PC adherence 0.60, FTE savings 19.96%, HC savings 1.14%",
            "Power BI sample (GMA Friday overdeployment view): Weekly Stores FTE 20.68; Roving FTE Proposed 27.20, Existing 6.53; all GMA Friday routes flagged as overdeployed by more than 2 hours",
            "Power BI sample (specific merchandiser view): Weekly Stores FTE 1.30; Roving FTE Proposed 2.01, Existing 0.71; Headcount Efficiency 100.00%",
            "SEL: HC Efficiency 0.83, PC adherence 0.61, FTE savings 37.26%, HC savings 27.15%",
            "SM: HC Efficiency 0.76, PC adherence 0.55, FTE savings 29.01%, HC savings 17.08%",
            "SWL: HC Efficiency 0.77, PC adherence 0.49, FTE savings 41.60%, HC savings 27.25%",
            "WV: HC Efficiency 0.78, PC adherence 0.38, FTE savings 37.47%, HC savings 25.42%" ;
        fact:delivery-shape "Infrastructure architecture with FICO as the optimization solver and a Power BI presentation layer for routes, merchandiser schedules and coverage metrics" ;
        fact:project-summary "Route stitching model that clusters store visits into roving merchandiser routes per Philippine region; outputs roving headcount (number of merchandisers needed to cover all routes), measured by HC Efficiency, PC adherence, FTE savings and HC savings" ;
        fact:proposed-solution "Route stitching optimization model solved with FICO; outputs roving headcount and clustered weekly schedules; Power BI dashboard shows all routes, routes by day of week, routes per merchandiser and extra coverage opportunities" ;
        fact:scope "Nine Philippine regions (CL, EV, GMA, NL, NM, SEL, SM, SWL, WV); roving merchandiser route clustering and headcount sizing" ;
        fact:solution-direction "Use Power BI to identify extra coverage opportunities as routes with overdeployment greater than 2 hours" ;
        fact:target-context "Philippines regions: CL, EV, GMA, NL, NM, SEL, SM, SWL, WV (map also highlights GMA, Palawan, Mindanao)" ;
        onto:kind "Project" ;
        relation:project-uses-technology entity:fico-xpress,
            entity:power-bi ;
        rdfs:comment "Route stitching / clustering engagement that optimizes roving merchandiser routes across Philippine regions, producing roving headcount, FTE and headcount savings, with results presented in a Power BI dashboard and solved with FICO" ;
        skos:altLabel "Route stitching model",
            "Roving merchandiser routing" ;
        skos:prefLabel "Merchandiser Route Optimization (Philippines)" .

