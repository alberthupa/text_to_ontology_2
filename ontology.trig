        ns2:business-objectives "ULB growth; Sales value growth; Sales volume growth",
            "distribution expansion, incremental line growth, rep productivity" ;
        ns2:channels "Traditional Trade" ;
        ns2:configuration "Built once as CORE (shared architecture, pipeline logic, business rules engine) and customised per market through configuration only; no code changes required for new market deployment" ;
        ns2:deployment-approach "configuration only, no code changes required for new market deployment" ;
        ns2:design-principle "target type is a product parameter, not a custom build; each market selects one target type at onboarding" ;
        ns2:goals "distribution expansion, incremental line growth, rep productivity" ;
        ns2:markets-in-scope "India (priority), Morocco, Egypt, RSA operationalisation" ;
        ns2:number-of-core-ml-capabilities "3" ;
        ns2:operating-cadences "monthly planning and weekly execution" ;
        ns2:out-of-scope "Target-setting and simulation",
            "target-setting, target simulation, and target negotiation" ;
        ns2:priority-market "India" ;
        ns2:recommendation-phases "Monthly Sales Plan generation; Weekly Suggested Order generation" ;
        ns2:required-dataset-families-per-market "8 (first four mandatory for launch; remaining phased)" ;
        ns2:suggestion-properties "data-driven, rules-compliant, auditable" ;
        ns2:suggestion-qualities "data-driven, rules-compliant, auditable" ;
        ns2:target-handling "receives a monthly target, verifies whether recommendations achieve it, and applies a stretch if needed" ;
        ns2:type "ML-driven store replenishment platform" ;
        ns2:value-proposition "the right product is in the right store at the right quantity" ;
