    entity:merchandiser-store-visit-routing-and-scheduling-optimization a onto:Entity,
            class:project,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Merchandiser Store Visit Routing and Scheduling Optimization" ;
        fact:assumptions "Store Schedule Assignment constraints: visit frequency, visit duration, and which stores can be visited as part of the same route; decision variables are binary store-to-schedule assignments plus auxiliary variables" ;
        fact:business-need "Minimize the number of merchandisers (headcount) and travel distance needed to visit roving stores while respecting visit frequency, duration, routing and political constraints" ;
        fact:delivery-evidence "Performance Insights report compares existing and proposed FTE store assignments ('What improved?'); Opportunities analysis identifies regions where new stores/outlets can be added with little extra cost ('Where can we add new outlets?')" ;
        fact:project-summary "Optimization solution for merchandiser store visits: maps stores with OpenStreetMap, assigns stores to weekly schedules (MIP), optimizes daily routes (vehicle routing) and builds weekly merchandiser schedules (heuristic), presented via a Power BI dashboard, performance insights and opportunities analysis" ;
        fact:proposed-solution "Store mapping step (Where are the stores?) using OpenStreetMap to compute distance and time matrices; Optimization layer with three models: Store Schedule Assignment (What day(s) to visit each store on?), Daily Route Optimization (How to visit the stores?) and Weekly Schedule Creation (How to allocate merchandisers to routes?); Presentation layer with Power BI Dashboard, Performance Insights report and Opportunities analysis" ;
        fact:scope "Roving stores; store mapping, schedule assignment, daily routing, weekly scheduling, and presentation layer (dashboard filterable by region, store chain, day of week; existing vs proposed FTE store assignments; regions where new outlets can be added at little extra cost)" ;
        fact:solution-direction "Mixed integer programming (via FICO Xpress Python library) for store-to-schedule assignment, vehicle routing model for daily routes, heuristic model for weekly schedules; linear programming chosen as well suited to assignment problems with an objective function and restrictions" ;
        onto:kind "Project" ;
        relation:project-uses-technology entity:fico-xpress,
            entity:mixed-integer-programming,
            entity:openstreetmap,
            entity:power-bi,
            entity:python ;
        rdfs:comment "Optimization solution that maps store locations, assigns stores to weekly visit schedules, optimizes daily routes and builds weekly merchandiser schedules while minimizing headcount, with a Power BI presentation layer" ;
        skos:altLabel "Merchandiser Route Optimization",
            "Store Visit Optimization" ;
        skos:prefLabel "Merchandiser Store Visit Routing and Scheduling Optimization" .

