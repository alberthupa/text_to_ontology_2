    <http://example.org/text-ontology/candidate/doc-d57fd025fa07132e/win-aa09c910529d21ee/fact/1/statement/0> a rdf:Statement ;
        rdf:object "Configurable month boundary rule (clean-cut vs ratio-based), visit frequency per store (weekly/bi-weekly/monthly), working week definition (start day, weekend days, holidays), and monthly-to-weekly mapping (effective visit weeks per month)" ;
        rdf:predicate ns2:approach ;
        rdf:subject <http://example.org/text-ontology/entity/calendar-visit-plan> .

    <http://example.org/text-ontology/candidate/doc-d57fd025fa07132e/win-aa09c910529d21ee/fact/2> a prov:Collection ;
