    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-476ce492fae6a052/fact/2/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Total time per merchandiser (travel + in-store) limited to 8h maximum; political constraints respected; for stores with visit durations >= 2h, travel time up to 30 min is included as part of the visit time; if route time < 8 hours, the extra merchandiser time is spread equally across all stores in the route, creating overdeployment" ;
        rdf:predicate fact:assumptions ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-e68fe065f017f95e/review/win-476ce492fae6a052/e1> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-e68fe065f017f95e> .

    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-476ce492fae6a052/fact/3> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-476ce492fae6a052/fact/3/statement/0> ;
        prov:wasGeneratedBy <http://example.org/text-ontology/activity/b95a5c792492e0f8> .

    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-476ce492fae6a052/fact/3/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Vehicle routing problem built with ortools Python library: dummy depot location with 0 travel distance/time to all other locations to handle lack of central start/end point; different 'vehicle' types that can only visit stores belonging to the same political constraint group; limits on total work time and travel distance included in respective dimensions; service time added to travel time in the time callback; travel time <= 30 min disregarded for store durations >= 2h in time callback; fixed cost added for using a merchandiser (vehicle)" ;
        rdf:predicate fact:proposed-solution ;
        rdf:subject <http://example.org/text-ontology/provisional/doc-e68fe065f017f95e/review/win-476ce492fae6a052/e1> ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-e68fe065f017f95e> .

