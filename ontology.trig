    entity:chinese-industrial-overcapacity a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Chinese industrial overcapacity" ;
        onto:kind "Threat" ;
        relation:affects-region entity:european-union ;
        relation:originates-from entity:china ;
        relation:threatens entity:european-union ;
        rdfs:comment "Overcapacity in electric vehicles, solar components, wind equipment, and semiconductors, framed in Europe as an economic security issue" ;
        skos:prefLabel "Chinese industrial overcapacity" .

    entity:chinese-rare-earth-export-controls a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Chinese rare-earth export controls" ;
        fact:threat-type "export controls" ;
        onto:kind "Threat" ;
        relation:originates-from entity:china ;
        relation:threatens entity:critical-minerals ;
        rdfs:comment "Expanded export controls or tighter restrictions from Beijing on rare earths that can create immediate disruptions well beyond China itself" ;
        skos:altLabel "Chinese export controls",
            "restrictions from Beijing" ;
        skos:prefLabel "Chinese rare-earth export controls" .

    entity:critical-mineral-concentration-risk a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Critical mineral concentration risk" ;
        fact:threat-type "supply chain concentration risk" ;
        onto:kind "Threat" ;
        relation:originates-from entity:china ;
        rdfs:comment "Risk arising from concentration of rare-earth processing and downstream manufacturing in China, threatening industrial output and military readiness if access is cut" ;
        skos:altLabel "concentration risk" ;
        skos:prefLabel "Critical mineral concentration risk" .

    entity:extreme-weather a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Extreme weather" ;
        onto:kind "Threat" ;
        rdfs:comment "Major near-term global risk identified in the WEF 2026 global risks work" ;
        skos:prefLabel "Extreme weather" .

    entity:geoeconomic-confrontation a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Geoeconomic confrontation" ;
        fact:threat-type "economic" ;
        onto:kind "Threat" ;
        rdfs:comment "Top near-term global risk in the World Economic Forum's 2026 global risks work; use of tariffs, export controls, sanctions and supply agreements as strategic weapons" ;
        skos:prefLabel "Geoeconomic confrontation" .

    entity:interstate-conflict a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Interstate conflict" ;
        fact:threat-type "military" ;
        onto:kind "Threat" ;
        rdfs:comment "Major near-term global risk identified in the WEF 2026 global risks work" ;
        skos:prefLabel "Interstate conflict" .

    entity:iran a onto:Entity,
            class:country,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Iran" ;
        onto:kind "Country" ;
        rdfs:comment "Country whose involvement in conflict affects global fuel prices, Asian energy importers, and European political choices" ;
        skos:prefLabel "Iran" .

    entity:kirill-dmitriev a onto:Entity,
            class:politician,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Kirill Dmitriev" ;
        onto:kind "Politician" ;
        relation:citizen-of entity:russia ;
        rdfs:comment "Russian envoy who visited Washington amid discussion of sanctions relief and possible peace terms" ;
        skos:prefLabel "Kirill Dmitriev" .

    entity:misinformation a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Misinformation" ;
        onto:kind "Threat" ;
        rdfs:comment "Major near-term global risk identified in the WEF 2026 global risks work" ;
        skos:prefLabel "Misinformation" .

    entity:nato a onto:Entity,
            class:institution,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "NATO" ;
        onto:kind "Institution" ;
        rdfs:comment "Military alliance emphasizing stronger conventional deterrence, faster technology adoption and sustained allied defense spending; Russia demanded a written pledge it stop expanding eastward" ;
        skos:prefLabel "NATO" .

    entity:orthodox-easter-ceasefire a onto:Entity,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Orthodox Easter ceasefire" ;
        onto:kind "Entity" ;
        rdfs:comment "Short ceasefire announced around Orthodox Easter 2026 in the Russia-Ukraine war between Russia and Ukraine; both sides quickly accused each other of violations" ;
        skos:prefLabel "Orthodox Easter ceasefire" .

    entity:paris-talks-on-trump-xi-summit a onto:Entity,
            class:conference,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Paris talks on Trump-Xi summit" ;
        onto:kind "Conference" ;
        rdfs:comment "Talks held in Paris by officials aimed at preparing a future Trump-Xi summit" ;
        skos:prefLabel "Paris talks on Trump-Xi summit" .

    entity:rare-earths a onto:Entity,
            class:asset,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Rare earths" ;
        fact:asset-type "critical mineral" ;
        onto:kind "Asset" ;
        relation:originates-from entity:china ;
        rdfs:comment "Strategic supply chokepoint shaping industrial production and defense manufacturing" ;
        skos:altLabel "rare-earth processing",
            "rare-earth supply" ;
        skos:prefLabel "Rare earths" .

    entity:russia-ukraine-war a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Russia-Ukraine war" ;
        fact:active "true" ;
        fact:threat-type "war" ;
        onto:kind "Threat" ;
        relation:originates-from entity:russia ;
        relation:threatens entity:ukraine ;
        rdfs:comment "Ongoing war between Russia and Ukraine as of April 2026, entangled with sanctions policy, oil-market management and alliance politics, with diplomacy active but stalled" ;
        skos:altLabel "war in Ukraine" ;
        skos:prefLabel "Russia-Ukraine war" .

    entity:societal-polarization a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Societal polarization" ;
        onto:kind "Threat" ;
        rdfs:comment "Major near-term global risk identified in the WEF 2026 global risks work" ;
        skos:prefLabel "Societal polarization" .

    entity:strait-of-hormuz a onto:Entity,
            class:asset,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Strait of Hormuz" ;
        fact:asset-type "energy" ;
        onto:kind "Asset" ;
        rdfs:comment "Critical energy shipping chokepoint that shapes global oil supply" ;
        skos:prefLabel "Strait of Hormuz" .

    entity:ukrainian-attacks-on-russian-refining-capacity a onto:Entity,
            class:threat,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Ukrainian attacks on Russian refining capacity" ;
        fact:threat-type "attack on energy infrastructure" ;
        onto:kind "Threat" ;
        relation:originates-from entity:ukraine ;
        relation:targets entity:russia ;
        relation:threatens entity:russia ;
        rdfs:comment "Ukrainian strikes that reportedly damaged Russian energy infrastructure enough to affect Russia's export decisions" ;
        skos:prefLabel "Ukrainian attacks on Russian refining capacity" .

    entity:us-eu-coordinated-mineral-strategy a onto:Entity,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "US-EU coordinated mineral strategy" ;
        onto:kind "Entity" ;
        relation:organized-by entity:european-union,
            entity:united-states ;
        rdfs:comment "Coordinated critical mineral strategy pursued by European and US officials aimed at price stability and reduced vulnerability to Chinese-controlled supply" ;
        skos:altLabel "coordinated mineral strategy" ;
        skos:prefLabel "US-EU coordinated mineral strategy" .

    entity:us-export-restrictions-on-advanced-chips a onto:Entity,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "US export restrictions on advanced chips" ;
        onto:kind "Entity" ;
        relation:originates-from entity:united-states ;
        relation:targets entity:advanced-chips,
            entity:china ;
        rdfs:comment "US export controls limiting China's access to advanced chips, which redirected trade into opaque channels rather than eliminating demand" ;
        skos:altLabel "export controls",
            "technology controls" ;
        skos:prefLabel "US export restrictions on advanced chips" .

    entity:us-sanctions-waiver-on-russian-oil a onto:Entity,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "US sanctions waiver on Russian oil" ;
        fact:active "true" ;
        fact:end-date "2026-04-11" ;
        fact:start-date "2026-03" ;
        onto:kind "Entity" ;
        relation:organized-by entity:united-states ;
        rdfs:comment "Temporary US sanctions waiver on Russian oil introduced in mid-March 2026 as a market-stabilization measure during an Iran-linked energy shock, set to expire April 11, 2026; criticized for risking revenue to Moscow and reduced Western leverage" ;
        skos:altLabel "sanctions waiver" ;
        skos:prefLabel "US sanctions waiver on Russian oil" .

    entity:world-economic-forum a onto:Entity,
            class:institution,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "World Economic Forum" ;
        onto:kind "Institution" ;
        rdfs:comment "Organization whose 2026 global risks work ranks geoeconomic confrontation as the top near-term risk" ;
        skos:altLabel "WEF" ;
        skos:prefLabel "World Economic Forum" .

    entity:advanced-chips a onto:Entity,
            class:asset,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Advanced chips" ;
        fact:asset-type "strategic technology" ;
        onto:kind "Asset" ;
        rdfs:comment "Strategic chokepoint shaping AI capacity and high-end computing; semiconductor access is affected by trade measures" ;
        skos:altLabel "advanced semiconductors",
            "high-end processors",
            "semiconductors" ;
        skos:prefLabel "Advanced chips" .

    entity:critical-minerals a onto:Entity,
            class:asset,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Critical minerals" ;
        fact:asset-type "strategic mineral input" ;
        onto:kind "Asset" ;
        rdfs:comment "Strategic inputs including rare earths on which Washington and Brussels are moving toward deeper coordination" ;
        skos:altLabel "critical mineral inputs" ;
        skos:prefLabel "Critical minerals" .

    entity:ukraine a onto:Entity,
            class:country,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Ukraine" ;
        onto:kind "Country" ;
        rdfs:comment "Country at war with Russia, favoring freezing the conflict roughly along current lines; its forces attacked Russian refining capacity" ;
        skos:prefLabel "Ukraine" .

    entity:united-states a onto:Entity,
            class:country,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "United States" ;
        onto:kind "Country" ;
        relation:allied-with entity:european-union ;
        rdfs:comment "Country whose trade, industrial policy, and defense planning are affected by competition with China" ;
        skos:altLabel "US",
            "Washington" ;
        skos:prefLabel "United States" .

    entity:european-union a onto:Entity,
            class:institution,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "European Union" ;
        onto:kind "Institution" ;
        rdfs:comment "European bloc dealing with Chinese industrial overcapacity and coordinating with Washington on critical minerals" ;
        skos:altLabel "Brussels",
            "EU",
            "Europe",
            "European officials" ;
        skos:prefLabel "European Union" .

    entity:russia a onto:Entity,
            class:country,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Russia" ;
        onto:kind "Country" ;
        rdfs:comment "Country at war with Ukraine, subject to Western sanctions, rejecting a freeze of the conflict along current lines and seeking broader territorial concessions, a written pledge that NATO stops expanding eastward, and easing of several sanctions" ;
        skos:altLabel "Moscow" ;
        skos:prefLabel "Russia" .

    entity:china a onto:Entity,
            class:country,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "China" ;
        onto:kind "Country" ;
        rdfs:comment "Country whose competition with others affects trade, industrial policy, and defense planning across the United States, Europe, and East Asia" ;
