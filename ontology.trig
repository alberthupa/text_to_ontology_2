    <http://example.org/text-ontology/candidate/doc-6b061eb3d8160746/win-464eb4f0fb861387/fact/5> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-6b061eb3d8160746/win-464eb4f0fb861387/fact/5/statement/0> ;
