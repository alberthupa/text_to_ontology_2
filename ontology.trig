    <http://example.org/text-ontology/entity/quantity-reconciliation> a ns3:Entity,
            <http://example.org/text-ontology/class/entity>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Quantity Reconciliation" ;
        ns2:business-value "Recommendations stay fresh throughout the month without manual intervention — quantities reflect what has already been sold, preventing overstocking and keeping orders aligned with the monthly plan",
            "Recommendations stay fresh throughout the month without manual intervention — quantities reflect what has already been sold, preventing overstocking and keeping orders aligned with the monthly plan." ;
        ns2:description "Aligns weekly quantity predictions against the remaining monthly target; tracks carry-forward of recommended vs. actually sold; drops SKUs from the live pool when monthly target is fully met" ;
        ns2:formula "weekly_qty = MIN(weekly_prediction, remaining_monthly)",
            "weekly_qty = MIN(weekly_prediction, remaining_monthly_target)" ;
        ns2:key-output "Reconciled quantities + live candidate pool" ;
        ns3:kind "Entity" ;
        ns4:aligns-against-monthly-target-of <http://example.org/text-ontology/entity/monthly-sales-plan> ;
        ns4:aligns-weekly-predictions-of <http://example.org/text-ontology/entity/quantity-prediction-qty> ;
        ns4:depends-on <http://example.org/text-ontology/entity/calendar-visit-plan> ;
        ns4:feature-of <http://example.org/text-ontology/entity/mondelez-suggested-orders-2-0> ;
        ns4:follows <http://example.org/text-ontology/entity/quantity-prediction-qty> ;
        ns4:frees-slots-for-candidates-from <http://example.org/text-ontology/entity/monthly-sales-plan> ;
        ns4:part-of <http://example.org/text-ontology/entity/mondelez-suggested-orders-2-0> ;
        ns4:precedes <http://example.org/text-ontology/entity/assortment-re-ranking> ;
        rdfs:comment "Product feature of Suggested Orders 2.0" ;
        skos:altLabel "B1",
            "quantity allocation" ;
