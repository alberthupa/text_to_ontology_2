        ns2:prompted-by-energy-shock-linked-to-conflict-involving <http://example.org/text-ontology/entity/iran> ;
        rdfs:comment "Temporary US sanctions waiver on Russian oil introduced in mid-March 2026 during an energy shock, justified as market stabilization, set to expire April 11, criticized for risking Moscow revenue and reducing Western leverage" ;
