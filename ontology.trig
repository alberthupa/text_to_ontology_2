        ns4:uses <http://example.org/text-ontology/entity/fico-xpress> ;
        rdfs:comment "Model #1 of the case study: assigns stores to specific schedules (e.g. MWF, TuTh) using binary store-schedule decision variables, minimizing the number of merchandisers needed; its output is the set of stores to be visited on each day of the week" ;
        skos:altLabel "Model 1",
            "model #1" ;
        skos:prefLabel "Store Schedule Assignment Model" .

