    <http://example.org/text-ontology/candidate/doc-d57fd025fa07132e/win-aa09c910529d21ee/fact/2/statement/0> a rdf:Statement ;
        rdf:object "Partial weeks (a calendar month rarely contains exactly 4 full weeks); visit frequencies (weekly, bi-weekly, monthly per store); intra-week patterns (top stores visited Mon/Tue, 60-70% of weekly volume may concentrate in the first 2 days); market-specific working weeks (start day Monday, Sunday or Saturday; differing weekend days)" ;
        rdf:predicate ns2:complexity ;
        rdf:subject <http://example.org/text-ontology/entity/calendar-visit-plan> .

