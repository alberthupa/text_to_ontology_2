<http://example.org/text-ontology/graphs/schema> {
    fact:birth-date a owl:DatatypeProperty ;
        rdfs:label "birth date" ;
        rdfs:comment "date of birth" ;
        rdfs:domain class:politician ;
        rdfs:range xsd:date .

    fact:capital a owl:DatatypeProperty ;
        rdfs:label "capital" ;
        rdfs:comment "capital city name" ;
        rdfs:domain class:country ;
        rdfs:range xsd:string .

    fact:end-date a owl:DatatypeProperty ;
        rdfs:label "end date" ;
        rdfs:comment "last day of the conference" ;
        rdfs:domain class:conference ;
        rdfs:range xsd:date .

    fact:founded-in a owl:DatatypeProperty ;
        rdfs:label "founded in" ;
        rdfs:comment "year the institution started" ;
        rdfs:domain class:institution ;
        rdfs:range xsd:integer .

    fact:iso-code a owl:DatatypeProperty ;
        rdfs:label "iso code" ;
        rdfs:comment "ISO country code" ;
        rdfs:domain class:country ;
        rdfs:range xsd:string .

    fact:party a owl:DatatypeProperty ;
        rdfs:label "party" ;
        rdfs:comment "political party affiliation" ;
        rdfs:domain class:politician ;
        rdfs:range xsd:string .

    fact:population a owl:DatatypeProperty ;
        rdfs:label "population" ;
        rdfs:comment "number of inhabitants" ;
        rdfs:domain class:country ;
        rdfs:range xsd:integer .

    fact:severity a owl:DatatypeProperty ;
        rdfs:label "severity" ;
        rdfs:comment "severity level of the threat" ;
        rdfs:domain class:threat ;
        rdfs:range xsd:integer .

    fact:start-date a owl:DatatypeProperty ;
        rdfs:label "start date" ;
        rdfs:comment "first day of the conference" ;
        rdfs:domain class:conference ;
        rdfs:range xsd:date .

    fact:value a owl:DatatypeProperty ;
        rdfs:label "value" ;
        rdfs:comment "estimated worth of the asset" ;
        rdfs:domain class:asset ;
        rdfs:range xsd:decimal .

    fact:website a owl:DatatypeProperty ;
        rdfs:label "website" ;
        rdfs:comment "official web address" ;
        rdfs:domain class:institution ;
        rdfs:range xsd:anyURI .

    relation:affects-region a owl:ObjectProperty ;
        rdfs:label "affects region" ;
        rdfs:comment "threat impacts a region" ;
        rdfs:domain class:threat ;
        rdfs:range class:region .

    relation:allied-with a owl:ObjectProperty ;
        rdfs:label "allied with" ;
        rdfs:comment "country has an alliance with another country" ;
        rdfs:domain class:country ;
        rdfs:range class:country .

    relation:attended a owl:ObjectProperty ;
        rdfs:label "attended" ;
        rdfs:comment "politician took part in a conference" ;
        rdfs:domain class:politician ;
        rdfs:range class:conference .

    relation:citizen-of a owl:ObjectProperty ;
        rdfs:label "citizen of" ;
        rdfs:comment "politician holds nationality of a country" ;
        rdfs:domain class:politician ;
        rdfs:range class:country .

    relation:headquartered-in a owl:ObjectProperty ;
        rdfs:label "headquartered in" ;
        rdfs:comment "institution is based in a country" ;
        rdfs:domain class:institution ;
        rdfs:range class:country .

    relation:holds-office-in a owl:ObjectProperty ;
        rdfs:label "holds office in" ;
        rdfs:comment "politician serves within an institution" ;
        rdfs:domain class:politician ;
        rdfs:range class:institution .

    relation:hosted-by a owl:ObjectProperty ;
        rdfs:label "hosted by" ;
        rdfs:comment "conference is hosted by a country" ;
        rdfs:domain class:conference ;
        rdfs:range class:country .

    relation:located-in a owl:ObjectProperty ;
        rdfs:label "located in" ;
        rdfs:comment "country belongs to a region" ;
        rdfs:domain class:country ;
        rdfs:range class:region .

    relation:member-of a owl:ObjectProperty ;
        rdfs:label "member of" ;
        rdfs:comment "country is a member of an institution" ;
        rdfs:domain class:country ;
        rdfs:range class:institution .

    relation:organized-by a owl:ObjectProperty ;
        rdfs:label "organized by" ;
        rdfs:comment "conference is organized by an institution" ;
        rdfs:domain class:conference ;
        rdfs:range class:institution .

    relation:originates-from a owl:ObjectProperty ;
        rdfs:label "originates from" ;
        rdfs:comment "threat comes from a country" ;
        rdfs:domain class:threat ;
        rdfs:range class:country .

    relation:owns a owl:ObjectProperty ;
        rdfs:label "owns" ;
        rdfs:comment "country controls an asset" ;
        rdfs:domain class:country ;
        rdfs:range class:asset .

    fact:active a owl:DatatypeProperty ;
        rdfs:label "active" ;
        rdfs:comment "whether the threat is currently active" ;
        rdfs:domain class:threat ;
        rdfs:range xsd:boolean .

    class:region a owl:Class ;
        rdfs:label "Region" ;
        rdfs:comment "a geographic or geopolitical area" ;
        rdfs:subClassOf onto:Entity .

    relation:targets a owl:ObjectProperty ;
        rdfs:label "targets" ;
        rdfs:comment "threat is directed at an asset" ;
        rdfs:domain class:threat ;
        rdfs:range class:asset .

    fact:asset-type a owl:DatatypeProperty ;
        rdfs:label "asset type" ;
        rdfs:comment "kind of asset such as military, energy or financial" ;
        rdfs:domain class:asset ;
        rdfs:range xsd:string .

    fact:threat-type a owl:DatatypeProperty ;
        rdfs:label "threat type" ;
        rdfs:comment "kind of threat such as military, cyber or economic" ;
        rdfs:domain class:threat ;
        rdfs:range xsd:string .

    relation:threatens a owl:ObjectProperty ;
        rdfs:label "threatens" ;
        rdfs:comment "threat endangers a country" ;
        rdfs:domain class:threat ;
        rdfs:range class:country .

    class:conference a owl:Class ;
        rdfs:label "Conference" ;
        rdfs:comment "a meeting or summit on geopolitical matters" ;
        rdfs:subClassOf onto:Entity .

    class:politician a owl:Class ;
        rdfs:label "Politician" ;
        rdfs:comment "a person active in politics" ;
        rdfs:subClassOf onto:Entity .

    class:asset a owl:Class ;
        rdfs:label "Asset" ;
        rdfs:comment "a resource or capability of strategic value" ;
        rdfs:subClassOf onto:Entity .

    class:institution a owl:Class ;
        rdfs:label "Institution" ;
        rdfs:comment "an organization such as a government body or international organization" ;
        rdfs:subClassOf onto:Entity .

    class:threat a owl:Class ;
        rdfs:label "Threat" ;
        rdfs:comment "a risk to a country, region or asset" ;
        rdfs:subClassOf onto:Entity .

    class:country a owl:Class ;
        rdfs:label "Country" ;
        rdfs:comment "a sovereign state" ;
        rdfs:subClassOf onto:Entity .

    onto:Entity a owl:Class ;
        rdfs:label "Entity" .
}

