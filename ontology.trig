    <http://example.org/text-ontology/statement/4b6b05cfb7d0a24216281f24fa62b9a4280946828a74f687531f4ea4f6fc01f6> a rdf:Statement,
            prov:Entity ;
        onto:sourceFile <http://example.org/text-ontology/source-file/139102c7bcfb58da57936bc827dad9d497ad5319b67801fbe6234fcf566715d7> ;
        rdf:object "Four capability areas: (1) Routing Engine Integration - Google Maps / HERE Maps API with 2024+ data, real-time traffic and road condition awareness, turn-by-turn mobile navigation for field reps; (2) Dynamic Route Management - daily & intra-day adjustments, no CSV uploads, automated exception handling for weather & accidents, promo and upsell priority routing support; (3) Territory & Compliance - hard territory boundary enforcement across all CUs, route optimisation within assigned territories, compliance tracking with deviation flagging; (4) Analytics & Visibility - near-real-time route execution dashboards, coverage gap analysis for underserved areas, KPI tracking for efficiency and rep performance" ;
        rdf:predicate fact:proposed-solution ;
        rdf:subject entity:routing-optimization-platform-proposal ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-6b061eb3d8160746> .

