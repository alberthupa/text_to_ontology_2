    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/0/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Assign stores to specific visit schedules (e.g. MWF, TuTh) and plan daily routes to minimize the number of merchandisers needed and travel distance, with restrictions on visit frequency, duration, which stores can share a route, max travel distance and max working time" ;
        rdf:predicate fact:business-context ;
        rdf:subject entity:merchandiser-resource-allocation ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-e68fe065f017f95e> .

