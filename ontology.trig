        skos:inScheme <https://example.org/ecmp/lingaro/asset/lingaro-glossary> ;
        ns1:classification "Public" ;
        ns1:domain <https://example.org/ecmp/lingaro/domain/marketing> ;
        ns1:primaryKey "assetId" ;
        ns1:sourceSystem "PKE",
            "SharePoint (Marketing)",
            "lingaro.com" .

    <https://example.org/ecmp/lingaro/domain/marketing> a ns1:Domain ;
        rdfs:label "Marketing"@en .

    <https://example.org/ecmp/lingaro/asset/accelerator> a skos:Concept ;
        dcterms:description "A pre-built, reusable building block that measurably shortens delivery of a Standard Solution or Service."@en ;
        skos:broader <https://example.org/ecmp/lingaro/asset/asset>,
            <https://example.org/ecmp/lingaro/asset/standard-solution> ;
        skos:inScheme <https://example.org/ecmp/lingaro/asset/lingaro-glossary> ;
        ns1:classification "Public" ;
        ns1:domain <https://example.org/ecmp/lingaro/domain/technology-innovation> ;
        ns1:primaryKey "assetId" ;
        ns1:sourceSystem "GitHub (<solution>-delivery-kit)",
            "SharePoint",
            "tech-registry" .

    <https://example.org/ecmp/lingaro/asset/asset> a skos:Concept ;
        dcterms:description "The master type for anything Lingaro builds once and reuses many times, independent of any one client or engagement."@en ;
        skos:inScheme <https://example.org/ecmp/lingaro/asset/lingaro-glossary> ;
        skos:narrower <https://example.org/ecmp/lingaro/asset/accelerator>,
            <https://example.org/ecmp/lingaro/asset/framework>,
            <https://example.org/ecmp/lingaro/asset/white-paper> ;
        skos:topConceptOf <https://example.org/ecmp/lingaro/asset/lingaro-glossary> ;
        ns1:classification "Public" ;
        ns1:domain <https://example.org/ecmp/lingaro/domain/technology-innovation> ;
        ns1:primaryKey "assetId" ;
        ns1:sourceSystem "GitHub (<solution>-generic-knowledge, <solution>-delivery-kit, <solution>-marketplace)",
            "PKE",
            "SharePoint" .

    <https://example.org/ecmp/lingaro/domain/legal-compliance> a ns1:Domain ;
        rdfs:label "Legal & Compliance"@en .

    <https://example.org/ecmp/lingaro/domain/commercial-sales> a ns1:Domain ;
        rdfs:label "Commercial & Sales"@en .

    <https://example.org/ecmp/lingaro/domain/consulting-advisory> a ns1:Domain ;
        rdfs:label "Consulting & Advisory"@en .

    <https://example.org/ecmp/lingaro/asset/contract> a skos:Concept ;
        dcterms:description "The master document type governing commercial terms between Lingaro and another party."@en ;
        skos:inScheme <https://example.org/ecmp/lingaro/asset/lingaro-glossary> ;
        skos:narrower <https://example.org/ecmp/lingaro/asset/b2b-agreement>,
            <https://example.org/ecmp/lingaro/asset/contract-amendment>,
            <https://example.org/ecmp/lingaro/asset/employment-agreement>,
            <https://example.org/ecmp/lingaro/asset/msa>,
            <https://example.org/ecmp/lingaro/asset/nda>,
            <https://example.org/ecmp/lingaro/asset/sow> ;
        skos:topConceptOf <https://example.org/ecmp/lingaro/asset/lingaro-glossary> ;
        ns1:classification "Public" ;
        ns1:domain <https://example.org/ecmp/lingaro/domain/legal-compliance> ;
        ns1:primaryKey "contractId" ;
        ns1:sourceSystem "SharePoint Sales Repo",
            "Sulu" .

    <https://example.org/ecmp/lingaro/domain/technology-innovation> a ns1:Domain ;
        rdfs:label "Technology & Innovation"@en .

    <https://example.org/ecmp/lingaro/domain/delivery> a ns1:Domain ;
        rdfs:label "Delivery"@en .

    <https://example.org/ecmp/lingaro/domain/organization> a ns1:Domain ;
        rdfs:label "Organization"@en .
}

<http://example.org/text-ontology/graphs/schema> {
    ns1:Process a owl:Class ;
        rdfs:label "Process"@en .

    ns1:classification a owl:DatatypeProperty ;
        rdfs:label "classification"@en .

    ns1:domain a owl:ObjectProperty ;
        rdfs:label "domain"@en .

    ns1:employeeBand a owl:DatatypeProperty ;
        rdfs:label "employee band"@en .

    ns1:formula a owl:DatatypeProperty ;
        rdfs:label "formula"@en .

    ns1:grain a owl:DatatypeProperty ;
        rdfs:label "grain"@en .

    ns1:headquarters a owl:DatatypeProperty ;
        rdfs:label "headquarters"@en .

    ns1:howToUse a owl:DatatypeProperty ;
        rdfs:label "how to use"@en .

    ns1:industry a owl:DatatypeProperty ;
        rdfs:label "industry"@en .

    ns1:legalName a owl:DatatypeProperty ;
        rdfs:label "legal name"@en .

    ns1:primaryKey a owl:DatatypeProperty ;
        rdfs:label "primary key"@en .

    ns1:purpose a owl:DatatypeProperty ;
        rdfs:label "purpose"@en .

    ns1:sourceSystem a owl:DatatypeProperty ;
        rdfs:label "source system"@en .

    ns1:unit a owl:DatatypeProperty ;
        rdfs:label "unit"@en .

    ns1:whenToUse a owl:DatatypeProperty ;
        rdfs:label "when to use"@en .

    <https://example.org/ecmp/lingaro/asset/availability> a owl:Class ;
        rdfs:label "Availability"@en ;
        rdfs:comment "Share of a person's contracted capacity still free to assign in a period."@en ;
        skos:definition """The share of a person's contracted capacity — measured in man-days across their own country's working days in the period — that is **not consumed** by bookings counted as busy under the selected scenario, nor by time off. It answers *how much of this person can I have*, not *when do they become free*: a capacity fraction, never a date and never a headcount.

Three structural properties:

- **A share of a full-time equivalent**, not of the person — a fully free 0.5-FTE contract correctly reads 50%, not 100%.
- **Floored at zero** — someone booked at 150% reads 0% free, never −50%.
- **Time off consumes only what a booking left** that day, which is why the number can never exceed 100%.

A booking reduces it only when **both** its status is in the scenario's busy set **and** its project type qualifies:

- `billable` and `governance` always count.
- `investment` counts only for the *Investment - ELT* and *Presales* work categories, plus *Central Investments* outside Pessimistic.
- `bench` — any project carrying none of the billable, governance or investment flags — counts only in Optimistic, and there only for *Account Assignment*.

Project type is derived from those cost-category flags and must be resolved **before** the work-category filter, so a flagless *Presales* project is bench, not investment.

The scenarios differ only in what is held against the person: **Pessimistic** counts Confirmed and Requested; **Realistic** (the default) adds Planned, Prebooked and Recommended; **Optimistic** adds Alternative and bench Account Assignment. The adjectives describe confidence in the demand *pipeline*, not in this number, so the direction is the opposite of most readers' first guess — **Pessimistic reports the most free capacity and Optimistic the least**. One Confirmed 100% bench booking reads 100% available in Realistic against 0% in Optimistic, so always state which scenario a figure came from.

Two rules for reading it:

- Across a multi-week window it is a **ratio of two sums** (total busy man-days ÷ total working days), *never the average of the weekly percentages* — one public holiday makes those disagree (55.6% correct against 50.0% averaged, in the canonical two-week case) and the error is silent, plausible-looking and always biased. For *free every week* questions use the minimum weekly value instead, skipping weeks with no working days.
- It is a **free-capacity** measure and is **not comparable** to a booking-total or allocation row: that measures load, moves in the opposite direction, and can legitimately exceed 100% when leave stacks on a full booking.

Where it is scored against a demand, the standard transformation is `fit = min(availability ÷ required FTE, 1.0)`, so surplus is not rewarded and shortfall scales linearly. It is a ranking signal, not a hard eligibility gate."""@en ;
        skos:prefLabel "Availability"@en .

    <https://example.org/ecmp/lingaro/asset/certificate> a owl:Class ;
        rdfs:label "Certificate"@en ;
        rdfs:comment "A formal, third-party credential attesting that a person or Lingaro meets a defined standard, subject to renewal."@en ;
        skos:altLabel "Accreditation"@en,
            "Badge"@en,
            "Certification"@en,
            "Credential"@en ;
        skos:definition """A formal credential issued by an external authority attesting that a Person or Lingaro itself meets a defined standard, and which expires or requires renewal. It is third-party evidence, which is what separates it from a Competency: a competency is an ability Lingaro asserts a person has, a certificate is an assertion someone outside Lingaro is willing to make and stand behind. Certificates exist in the model because they are counted and demanded — partner tier with a hyperscaler or platform vendor depends on how many current certificates Lingaro holds, and clients require named certifications in RFPs, security reviews and contract clauses. Both facts need answering from stock at a point in time, not from a spreadsheet someone maintains by hand.

How it connects: a Certificate is issued by a Person and evidences a Competency, and is about a Technology. It is required by an Opportunity, a Contract or an Engagement, and qualifies for an Offering."""@en ;
        skos:prefLabel "Certificate"@en .

    <https://example.org/ecmp/lingaro/asset/competency> a owl:Class ;
        rdfs:label "Competency"@en ;
        rdfs:comment "A named, assessable ability — technical, methodological, domain or behavioural — that a person can hold and apply."@en ;
        skos:altLabel "Capability (individual)"@en,
            "Competency Center"@en,
            "Expertise"@en,
            "Proficiency"@en,
            "Skill"@en ;
        skos:definition """A named, assessable ability a Person can hold and apply — technical, methodological, domain or behavioural. It is the type, not the holding: competency describes what the ability is (e.g. "dbt modelling", "Pharma commercial analytics", "stakeholder facilitation"), while proficiency level, evidence and currency belong to the link between a Person and a Competency. A competency exists independently of who currently holds it and of any engagement, which is what makes supply (who can do this) answerable against demand (what this work needs). It is not an Asset: an Asset is a reusable artifact Lingaro owns, a Competency is a reusable ability a person carries.

How it connects: a Competency is held by a Person and is about a Technology. It is required by an Engagement, a Service or a Standard Solution, and may be confirmed by a Certificate."""@en ;
        skos:prefLabel "Competency"@en .

    <https://example.org/ecmp/lingaro/asset/data-source> a owl:Class ;
        rdfs:label "Data Source / System or Records"@en ;
        rdfs:comment "A system of record backing object data — for example PKE, Sulu, ADO, Salesforce, SharePoint, or GitHub."@en ;
        skos:definition "A system of record backing object data (Foundry 'backing datasource'). Instances include PKE, Sulu, ADO, Salesforce/SalesRepo, SharePoint, GitHub, LSF, and Solutioning Cockpit."@en ;
        skos:prefLabel "Data Source / System or Records"@en .

    <https://example.org/ecmp/lingaro/asset/group> a owl:Class ;
        rdfs:label "Group"@en ;
        rdfs:comment "A collection of two or more people organized around a common business purpose, acting as a unit."@en ;
        skos:definition """A collection of people organized around a common business purpose, responsibility, capability, client, initiative, or area of interest, acting as a unit within an organization, project, engagement, community, or governance structure. Consists of two or more people, may be permanent or temporary, and may be internal, external, or mixed. May own, contribute to, or consume knowledge, and can participate in opportunities, engagements, projects, governance processes, and communities.

- **Organizational Group** — a formally defined organizational unit within Lingaro. Examples: Consulting & Advisory (C&A), Go-to-Market (GTM), Account Delivery Management (ADM) Team, Competency Centre (CC), Practice.
- **Delivery Team** — a group assembled to deliver client work.
- **Solution Squad** — a cross-functional group responsible for developing, maintaining, and promoting a standard solution.
- **Working Group** — a temporary group established to achieve a specific objective or initiative."""@en ;
        skos:prefLabel "Group"@en .

    <https://example.org/ecmp/lingaro/asset/implemented-solution> a owl:Class ;
        rdfs:label "Implemented Solution"@en ;
        rdfs:comment "The client-specific, delivered instance of a Standard Solution or bespoke combination, applied to solve one client's problem."@en ;
        skos:definition """The client-specific result of delivering a Standard Solution (or a bespoke combination of domain expertise, technology, data products, processes, and accelerators) to solve a particular client's problem (one or many use cases) and realize a defined business value for that client. It is the delivered instance, not a reusable catalog item — it is not itself sold, but is the outcome of selling and delivering a Service, Standard Solution, or Offering.

How it connects: an Implemented Solution is an instance of a Standard Solution or an Accelerator, and is the result of an Engagement. It is implemented at a Client, and results in a Success Story."""@en ;
        skos:prefLabel "Implemented Solution"@en .

    <https://example.org/ecmp/lingaro/asset/lesson-learned> a owl:Class ;
        rdfs:label "Lesson Learned"@en ;
        rdfs:comment "A per-engagement documented insight, positive or negative, captured to increase delivery on future projects."@en ;
        skos:definition """Per-engagement documented insights (both positive and negative) that can be used to increase delivery of future projects (learnings.md).

How it connects: a Lesson Learned describes an Engagement."""@en ;
        skos:prefLabel "Lesson Learned"@en .

    <https://example.org/ecmp/lingaro/asset/person> a owl:Class ;
        rdfs:label "Person"@en ;
        rdfs:comment "An individual who participates in, governs, delivers, or benefits from a business activity."@en ;
        skos:altLabel "client stakeholder"@en,
            "employee"@en,
            "partner"@en ;
        skos:definition """An individual who participates in, influences, contributes to, governs, sponsors, delivers, consumes, or benefits from a business activity, opportunity, engagement, project, solution, or knowledge asset. May be internal or external to Lingaro, can have one or more roles over time, can be associated with clients, opportunities, engagements, projects, solutions, deliverables, and communities, and serves as the connection point between knowledge, relationships, and business activities.

Recommended categories:

- **Employee** — employed or contracted by Lingaro, contributing to business operations, sales, solutioning, delivery, enablement, or support, regardless of employment form.
- **Client stakeholder** — represents a client organization and influences, sponsors, approves, funds, uses, or benefits from Lingaro's services, offerings, solutions, or engagements.
- **Partner** — represents an external organization that collaborates with Lingaro.

How it connects: a Person is part of an Engagement, a Client, or a Group."""@en ;
        skos:prefLabel "Person"@en .

    <https://example.org/ecmp/lingaro/asset/project-repo> a owl:Class ;
        rdfs:label "Project Repo"@en ;
        rdfs:comment "The single repository holding an engagement's delivery documentation."@en ;
        skos:definition """The per-engagement delivery repository. It contains all delivery documentation (both in the form of code and other files) including project management documentation.

How it connects: a Project Repo derives Client Knowledge and uses Technology."""@en ;
        skos:prefLabel "Project Repo"@en .

    <https://example.org/ecmp/lingaro/asset/proposal> a owl:Class ;
        rdfs:label "Proposal"@en ;
        rdfs:comment "A client-specific commercial document, prepared during an Opportunity, presenting Lingaro's proposed solution, scope and terms."@en ;
        skos:altLabel "RFI response"@en,
            "RFP response"@en,
            "offer"@en ;
        skos:definition """A client-specific commercial document prepared during an Opportunity that presents Lingaro's understanding of the client's need and the proposed solution, scope, approach, deliverables, timeline, team, assumptions, and commercial terms. It may be submitted proactively or in response to an RFI or RFP and may lead to an Engagement and a Statement of Work if accepted. A Proposal is a pre-signature sales artifact, not a contract and not evidence that the work has been commissioned.

How it connects: a Proposal relates to a Client, an Offering and an Opportunity, and results in an Engagement."""@en ;
        skos:prefLabel "Proposal"@en .

    <https://example.org/ecmp/lingaro/asset/success-story> a owl:Class ;
        rdfs:label "Success Story"@en ;
        rdfs:comment "Evidence of a delivered outcome, reused across sales and marketing."@en ;
        skos:definition """Evidence of a delivered outcome; reused across sales and marketing. Contains information about client challenges, solution and value delivered.

How it connects: a Success Story describes an Engagement and an Implemented Solution."""@en ;
        skos:prefLabel "Success Story"@en .

    <https://example.org/ecmp/lingaro/asset/technology> a owl:Class ;
        rdfs:label "Technology"@en ;
        rdfs:comment "A tool, platform, language, SaaS or framework used on projects."@en ;
        skos:definition """A tool, platform, programming language, SaaS or framework used in computer science projects.

How it connects: Technology is used at an Engagement and relates to an Offering."""@en ;
        skos:prefLabel "Technology"@en .

    <https://example.org/ecmp/lingaro/asset/use-case> a owl:Class ;
        rdfs:label "Use Case"@en ;
        rdfs:comment "A class of business problem, independent of any one client, where data, analytics, AI, automation, or technology can drive a measurable outcome."@en ;
        skos:definition """A class of business problem where data, analytics, AI, automation, or technology can be applied to achieve a measurable business outcome. It describes the nature of the challenge and the desired outcome, independent of any one client and independent of implementation.

- Can be industry-specific or cross-industry.
- May be addressed by multiple Standard Solutions and be part of multiple Offerings.
- Often used during discovery, consulting, opportunity qualification, and solution design."""@en ;
        skos:prefLabel "Use Case"@en .

    ns1:CompanyProfile a owl:Class ;
        rdfs:label "Company profile"@en .

    ns1:DataAsset a owl:Class ;
        rdfs:label "Data asset"@en .

    ns1:builtFrom a owl:ObjectProperty ;
        rdfs:label "Built from"@en ;
        rdfs:comment "The assets this report is computed from. Points from the consumer to what it reads."@en ;
        owl:inverseOf ns1:feeds .

    ns1:feeds a owl:ObjectProperty ;
        rdfs:label "Feeds"@en ;
        rdfs:comment "The reports computed from this asset."@en ;
        owl:inverseOf ns1:builtFrom .

    ns1:hasSubsidiary a owl:ObjectProperty ;
        rdfs:label "Has subsidiary"@en ;
        rdfs:comment "The legal entities this company owns. Transitive, mirroring subsidiary_of."@en ;
        owl:inverseOf ns1:subsidiaryOf .

    ns1:measuredBy a owl:ObjectProperty ;
        rdfs:label "Measured by"@en ;
        rdfs:comment "The metric that quantifies this concept."@en ;
        owl:inverseOf ns1:measures .

    ns1:measures a owl:ObjectProperty ;
        rdfs:label "Measures"@en ;
        rdfs:comment "The concept this metric quantifies."@en ;
        owl:inverseOf ns1:measuredBy .

    ns1:storedIn a owl:ObjectProperty ;
        rdfs:label "Stored in"@en ;
        rdfs:comment "The data asset holding instances of this concept. Points from the definition to the data."@en ;
        owl:inverseOf ns1:stores .

    ns1:stores a owl:ObjectProperty ;
        rdfs:label "Stores"@en ;
        rdfs:comment "The concepts whose instances this data asset holds."@en ;
        owl:inverseOf ns1:storedIn .

    ns1:subsidiaryOf a owl:ObjectProperty ;
        rdfs:label "Subsidiary of"@en ;
        rdfs:comment "The parent company of this legal entity. Transitive: a subsidiary of a subsidiary is a subsidiary."@en ;
        owl:inverseOf ns1:hasSubsidiary .

    <https://example.org/ecmp/lingaro/asset/b2b-agreement> a owl:Class ;
        rdfs:label "B2B Agreement"@en ;
        rdfs:comment "The commercial contract between Lingaro and a self-employed individual or supplier company providing people or services."@en ;
        rdfs:subClassOf <https://example.org/ecmp/lingaro/asset/contract> ;
        skos:altLabel "B2B"@en,
            "Contractor Agreement"@en,
            "Freelance Contract"@en,
            "Subcontracting Agreement"@en ;
        skos:definition """The commercial contract between Lingaro and a self-employed individual or a supplier company — contractor, freelancer, subcontractor, partner — supplying people or services to Lingaro rather than entering an employment relationship. It carries its own confidentiality, IP-assignment and back-to-back clauses so that obligations Lingaro owes a client under an MSA or SoW are passed through to whoever actually does the work.

How it connects: a B2B Agreement engages a Person or a Group, and sits back-to-back with an MSA or a SoW. It may be amended by a Contract Amendment."""@en ;
        skos:prefLabel "B2B Agreement"@en .

    <https://example.org/ecmp/lingaro/asset/client> a owl:Class ;
        rdfs:label "Client"@en ;
        rdfs:comment "An organization that purchases, or is being targeted to purchase, Lingaro services, offerings, or solutions."@en ;
        skos:altLabel "Account"@en,
            "Customer"@en ;
        skos:definition """An organization that purchases, has purchased, or is being targeted to purchase Lingaro services, offerings, or solutions. A client represents the company-level relationship and serves as the container for all related opportunities, engagements, projects, contacts, contracts, and knowledge assets. May also be called a customer or an Account (for example, in Salesforce).

How it connects: a Client has Engagements, Opportunities and Proposals."""@en ;
        skos:prefLabel "Client"@en .

    <https://example.org/ecmp/lingaro/asset/client-knowledge> a owl:Class ;
        rdfs:label "Client Knowledge"@en ;
        rdfs:comment "Per-client knowledge, technical or business, reusable across that client's engagements."@en ;
        skos:definition """Per-client knowledge reusable across that client's engagements. It may be both technical knowledge (standards, tech-stack, frameworks) and/or business knowledge like: industry, products or services the client sells, stakeholders working in Client, KPI, etc.

How it connects: Client Knowledge is derived into a Project Repo and relates to a Client."""@en ;
        skos:prefLabel "Client Knowledge"@en .

    <https://example.org/ecmp/lingaro/asset/contract-amendment> a owl:Class ;
        rdfs:label "Contract Amendment"@en ;
        rdfs:comment "A signed change to an existing contract — annex, addendum, change request or extension — altering its scope, price or terms."@en ;
        rdfs:subClassOf <https://example.org/ecmp/lingaro/asset/contract> ;
        skos:altLabel "Addendum"@en,
            "Aneks"@en,
            "Annex"@en,
            "CR"@en,
            "Change Request"@en,
            "Extension"@en ;
        skos:definition """A signed change to an existing contract — annex, addendum, change request, extension or termination notice — altering scope, deliverables, price, rates, term or terms. Modelled as a Contract subtype so that a change is itself a dated, signed, attributable document rather than an untracked edit to the original, which is what makes contracted scope and contracted value reconstructable at any point in time.

How it connects: a Contract Amendment amends an MSA, a SoW, an Employment Agreement or a B2B Agreement, and changes an Engagement."""@en ;
        skos:prefLabel "Contract Amendment"@en .

    <https://example.org/ecmp/lingaro/asset/delivery-director> a owl:Class ;
        rdfs:label "Delivery Director"@en ;
        rdfs:comment "Delivery Director provides strategic leadership for delivery operations, ensuring business growth, client success, operational excellence, and execution across multiple engagements."@en ;
        skos:definition "A Delivery Director is a senior leader responsible for defining and driving the strategic direction of delivery within a portfolio, account, or business area. They oversee complex engagements, manage senior stakeholder relationships, ensure operational excellence, and create conditions for sustainable business growth. Delivery Directors guide and mentor delivery leaders, shape delivery practices, drive innovation, and ensure that delivery capabilities support client objectives and organizational goals. They are accountable for overall delivery performance, customer success, organizational effectiveness, and long-term value creation."@en ;
        skos:prefLabel "Delivery Director"@en .

    <https://example.org/ecmp/lingaro/asset/delivery-leader> a owl:Class ;
        rdfs:label "Delivery Leader"@en ;
        rdfs:comment "Delivery Leader is accountable for successful service delivery, client satisfaction, team leadership, resource optimization, and execution of strategic initiatives across projects."@en ;
        skos:definition "A Delivery Leader is responsible for leading the delivery of services and solutions for one or more client engagements. They ensure projects are executed effectively, teams are aligned and utilized efficiently, risks are managed, and client expectations are met or exceeded. Delivery Leaders drive operational excellence, support business growth, optimize resource allocation, and act as trusted advisors to clients. They lead delivery teams, mentor team members, and contribute to continuous improvement while maintaining strong accountability for delivery outcomes, quality, timelines, and customer satisfaction."@en ;
        skos:prefLabel "Delivery Leader"@en .

    <https://example.org/ecmp/lingaro/asset/employment-agreement> a owl:Class ;
        rdfs:label "Employment Agreement"@en ;
        rdfs:comment "The contract between Lingaro and an individual employed under labour law."@en ;
        rdfs:subClassOf <https://example.org/ecmp/lingaro/asset/contract> ;
        skos:altLabel "Employment Contract"@en,
            "Labour Contract"@en,
            "Umowa o pracę"@en ;
        skos:definition """The contract between Lingaro and an individual employed under labour law, setting role, remuneration, working time, notice period, confidentiality and assignment of IP created at work. Together with the B2B Agreement it is how a Person becomes available to staff an Engagement, and the IP-assignment clause is what makes work produced in delivery reusable as an Asset.

How it connects: an Employment Agreement engages a Person and assigns them to a Group. It may be amended by a Contract Amendment."""@en ;
        skos:prefLabel "Employment Agreement"@en .

    <https://example.org/ecmp/lingaro/asset/engagement> a owl:Class ;
        rdfs:label "Engagement"@en ;
        rdfs:comment "A client-specific commercial and delivery relationship established to provide services or solutions."@en ;
        skos:altLabel "project"@en ;
        skos:definition """A client-specific commercial and delivery relationship established to provide services or solutions. It encompasses the work performed for a customer under a contract and may include one or multiple workstreams, or phases. It is Sulu-coded.

How it connects: an Engagement delivers an Implemented Solution and is governed by a SoW. It has a Project Repo and a Lesson Learned, and results in a Success Story."""@en ;
        skos:prefLabel "Engagement"@en .

    <https://example.org/ecmp/lingaro/asset/framework> a owl:Class ;
        rdfs:label "Framework (methodological)"@en ;
        rdfs:comment "A structured, reusable way of working — principles, phases, roles and criteria — applied to a class of problem, independent of client and technology."@en ;
        rdfs:subClassOf <https://example.org/ecmp/lingaro/asset/asset> ;
        skos:altLabel "Approach"@en,
            "Maturity Model"@en,
            "Methodology"@en,
            "Operating Model"@en,
            "Playbook"@en ;
        skos:definition """A structured, reusable way of working: principles, phases, roles, artifacts and assessment criteria that Lingaro applies to a class of problem independently of client and technology. Examples: data governance operating model, data maturity assessment model, cloud migration methodology, FinOps framework, self-healing-data operating model. A Framework is consumed by Services and Standard Solutions and is applied inside Engagements; it is documentation and method, not software.

How it connects: a Framework underpins a Service, a Standard Solution and an Offering, and is applied in an Engagement. It is owned by a Group."""@en ;
        skos:prefLabel "Framework (methodological)"@en .

    <https://example.org/ecmp/lingaro/asset/msa> a owl:Class ;
        rdfs:label "Master Service Agreement"@en ;
        rdfs:comment "The umbrella agreement setting the standing legal and commercial terms that apply to all work performed under it."@en ;
        rdfs:subClassOf <https://example.org/ecmp/lingaro/asset/contract> ;
        skos:altLabel "Framework Agreement"@en,
            "General Terms"@en,
            "MA"@en,
            "MSA"@en,
            "Master Agreement"@en ;
        skos:definition """The umbrella agreement between Lingaro and a client (or partner/subcontractor) setting the standing legal and commercial terms that apply to all work performed under it: liability, IP ownership, confidentiality, rate card, invoicing, warranties, governance and termination. An MSA does not by itself authorise or scope any work — deliverables, timeline and price come from a Statement of Work executed under it. One MSA typically governs many SoWs and therefore many Engagements.

How it connects: an MSA is signed with a Client or a Group, and is the parent of a SoW. It may be amended by a Contract Amendment."""@en ;
        skos:prefLabel "Master Service Agreement"@en .

    <https://example.org/ecmp/lingaro/asset/nda> a owl:Class ;
        rdfs:label "Non-Disclosure Agreement"@en ;
        rdfs:comment "The agreement restricting disclosure and use of confidential information exchanged between Lingaro and another party."@en ;
        rdfs:subClassOf <https://example.org/ecmp/lingaro/asset/contract> ;
        skos:altLabel "CDA"@en,
            "Confidentiality Agreement"@en,
            "Mutual NDA"@en,
            "NDA"@en ;
        skos:definition """A mutual or one-way agreement restricting disclosure and use of confidential information exchanged between Lingaro and a client, prospect, partner, subcontractor or individual. Typically the first document signed in an Opportunity, before client data, architecture detail or proposal pricing is shared. It also sets the limits on what may later be reused or published — so it constrains Client Knowledge and what a Success Story may name.

How it connects: an NDA is signed with a Client, a Person or a Group, and governs an Opportunity. It constrains Client Knowledge and Success Stories."""@en ;
        skos:prefLabel "Non-Disclosure Agreement"@en .

    <https://example.org/ecmp/lingaro/asset/offering> a owl:Class ;
        rdfs:label "Offering"@en ;
        rdfs:comment "A packaged, sellable commercial proposition that addresses one or more use cases."@en ;
        skos:definition """A packaged commercial proposition that addresses one or more use cases and responds to a market need. It combines one or more of: services, accelerators, methodologies, and Standard Solutions. Offerings are developed, marketed, and sold; they sit in Lingaro's portfolio and mature through a lifecycle (Conceptual → Delivered → Accelerated) reflecting how much delivery experience has been captured into reusable accelerators.

How it connects: an Offering includes a Service and a Standard Solution, addresses a Use Case, and is realized by an Engagement."""@en ;
        skos:prefLabel "Offering"@en .

    <https://example.org/ecmp/lingaro/asset/opportunity> a owl:Class ;
        rdfs:label "Opportunity"@en ;
        rdfs:comment "A potential revenue-generating business case being pursued with a client."@en ;
        skos:definition """A potential revenue-generating business case being pursued with a Client (customer or prospect). It is associated with a specific customer need, business outcome, budget, and initiative that Lingaro is actively exploring, proposing, or negotiating. It may convert to a project.

How it connects: an Opportunity is for a Client and converts to an Engagement."""@en ;
        skos:prefLabel "Opportunity"@en .

    <https://example.org/ecmp/lingaro/asset/product-engineer> a owl:Class ;
        rdfs:label "Product Engineer"@en ;
        rdfs:comment "A Product Engineer is an AI-enabled, client-facing solution owner who takes products from idea to production, combining business, design, architecture, and delivery expertise."@en ;
        skos:altLabel "Technical Generalist"@en ;
        skos:definition """A **Product Engineer** is an **AI-enabled technology generalist** who owns the **complete lifecycle** of a product or solution, from understanding a business need through design, implementation, deployment, and ongoing improvement. Unlike traditional delivery models that split responsibilities across business analysts, architects, developers, project managers, and product owners, a Product Engineer assumes **end-to-end accountability for delivering business outcomes**.

The role combines *product thinking*, *business understanding*, *solution design*, *technical delivery*, and *client engagement*. A Product Engineer works directly with stakeholders to understand problems, define requirements, design solutions, and ensure **measurable value** is delivered. Rather than specializing in a single technology domain, they maintain **broad competency across multiple disciplines** while applying **deep judgment** to business and product decisions.

A distinguishing characteristic of the role is the ability to **leverage AI agents throughout the delivery process**. Product Engineers use **agentic and spec-driven development** approaches to accelerate analysis, design, coding, testing, documentation, and deployment activities. While AI agents perform much of the implementation work, the Product Engineer remains responsible for **defining objectives**, **validating results**, **managing risks**, **making architectural decisions**, and **ensuring quality**.

The role is built around **six core capability areas**:

- **Client-Facing Product Ownership**: owning stakeholder relationships and product outcomes.
- **End-to-End Delivery with AI**: guiding solutions from concept to production using AI-powered delivery models.
- **Technical and Operational Ownership**: designing, deploying, and operating solutions responsibly.
- **Agentic Development with Spec-Driven Delivery**: directing AI agents using clear specifications and measurable objectives.
- **Solution Design**: creating and defending architecture and technology decisions.
- **Solo Delivering**: independently delivering complete business solutions when required.

Product Engineers create value by **transforming business challenges into working solutions**, **reducing handoffs** between teams, **accelerating delivery cycles**, and **maintaining accountability for outcomes rather than tasks**. They combine **technical breadth with business insight**, enabling them to operate across product strategy, requirements gathering, user experience, architecture, software engineering, data, testing, security, deployment, and support.

In SULU, a Product Engineer is represented as a dedicated role with associated specializations (Role Aspects) and is assessed through competency and proficiency tracking across six core Product Engineer capability areas.

**Role Expectations**:

A Product Engineer owns the delivery of a product end to end, from shaping the vision with the client to a solution that runs in production and has been handed over. AI agents do most of the implementation. The Product Engineer defines the goals, makes the decisions, verifies the results and is accountable for the outcome.

By default, a Product Engineer works solo and covers every critical project role:

- **Product Owner**: vision, scope, priorities, client relationship
- **Analyst**: requirements and testable acceptance criteria
- **Solution** Architect: the design and every technology decision
- **Developer**: implementation through AI agents, including tests
- **Delivery Lead**: planning, progress, risks, reporting
- **Operations**: deployment, production support, handover
**They lead and drive the delivery**. They set the direction, make decisions when information is incomplete, and push the product to a finished, working state. They are accountable for the result: measurable business value, running in production, and operable by its owner. Closing tasks is not the measure.

**Setups vary**. Solo is the default, not a rule. A project may include specialists or other Product Engineers. Whatever the setup, it must always be clear who owns the outcome.

**Help is always available.** Product Engineers can ask Lingaro experts for help at any time. Asking for advice is expected, but it does not transfer ownership. The Product Engineer still makes the decision and answers for it."""@en ;
        skos:prefLabel "Product Engineer"@en .

    <https://example.org/ecmp/lingaro/asset/sage> a owl:Class ;
        rdfs:label "SAGE"@en ;
        rdfs:comment "SAGE (Sense And Generate, Evolve) is Lingaro's AI-driven delivery methodology focused on rapid iterations, continuous feedback, and faster value delivery."@en ;
        skos:definition "Lingaro's AI-driven delivery methodology that combines rapid solution generation, continuous feedback, and iterative evolution to accelerate value delivery. SAGE emphasizes early delivery of working solutions, short feedback cycles, AI-assisted development, documentation-driven execution, and continuous adaptation of scope based on business needs. By treating change as inexpensive and leveraging AI to automate analysis, design, and development activities, SAGE enables faster time-to-value, improved transparency, reduced delivery risk, and higher alignment between delivered solutions and business outcomes. It complements Lingaro's AI-Accelerated Delivery model and Spec-Driven Development framework by providing a structured approach for planning, building, and evolving products in frequent increments."@en ;
        skos:prefLabel "SAGE"@en .

    <https://example.org/ecmp/lingaro/asset/service> a owl:Class ;
        rdfs:label "Service"@en ;
        rdfs:comment "A repeatable capability that Lingaro can provide to a client, independent of any specific technology or client."@en ;
        skos:definition """A repeatable capability provided to a client, delivered via personnel, methodologies, accelerators, and operational processes. Services describe what Lingaro executes, remain generally technology- and client-agnostic, and can be advisory, implementation, managed, or operational. A service can be brought to market as an independent offering or embedded within a larger packaged offering.

How it connects: a Service is part of an Offering and part of an Engagement."""@en ;
        skos:prefLabel "Service"@en .

    <https://example.org/ecmp/lingaro/asset/sow> a owl:Class ;
        rdfs:label "Statement of Work"@en ;
        rdfs:comment "The contract subtype that scopes one specific piece of work under a master agreement."@en ;
        rdfs:subClassOf <https://example.org/ecmp/lingaro/asset/contract> ;
        skos:altLabel "Project Order"@en,
            "Scope of Work"@en,
            "SoW"@en,
            "Work Order"@en ;
        skos:definition """The agreement that authorises and scopes one specific piece of work: objectives, scope, deliverables, timeline, team and roles, acceptance criteria, price, billing model and payment schedule. Normally executed under an MSA, which supplies the standing legal terms; where no MSA exists the SoW carries the full terms itself. This is the contract subtype that actually governs an Engagement, so it is where contracted scope and contracted value come from.

How it connects: a SoW sits under an MSA and governs an Engagement. It results from an Opportunity and may be amended by a Contract Amendment."""@en ;
        skos:prefLabel "Statement of Work"@en .

    <https://example.org/ecmp/lingaro/asset/white-paper> a owl:Class ;
        rdfs:label "White Paper"@en ;
        rdfs:comment "A published, externally shareable document presenting Lingaro's point of view on a business or technical problem."@en ;
        rdfs:subClassOf <https://example.org/ecmp/lingaro/asset/asset> ;
        skos:altLabel "POV"@en,
            "Point of View"@en,
            "Position Paper"@en,
            "Thought Leadership Paper"@en ;
        skos:definition """A published, externally shareable document presenting Lingaro's point of view on a business or technical problem, an industry trend, or a class of use case. It is used in marketing, thought leadership and early-stage sales to establish credibility and to frame a client's problem before any solution is proposed. Distinct from a Success Story (which is evidence of one specific delivery) and from a Blueprint (which is an internal build spec): a white paper makes an argument, is client-agnostic, and is cleared for external publication.

How it connects: a White Paper describes a Use Case, a Standard Solution or a Technology, and supports an Offering. It is used in an Opportunity, and is authored by a Person and owned by a Group."""@en ;
        skos:prefLabel "White Paper"@en .

    <https://example.org/ecmp/lingaro/asset/accelerator> a owl:Class ;
        rdfs:label "Accelerator"@en ;
        rdfs:comment "A pre-built, reusable building block that measurably shortens delivery of a Standard Solution or Service."@en ;
        rdfs:subClassOf <https://example.org/ecmp/lingaro/asset/asset>,
            <https://example.org/ecmp/lingaro/asset/standard-solution> ;
        skos:altLabel "Jumpstart"@en,
            "Pre-built Asset"@en,
            "Reusable Component"@en ;
        skos:definition """A pre-built, reusable building block — code, pipeline, data model, prompt set, notebook, IaC module, test harness or document template — that measurably shortens delivery of a Standard Solution or a Service. Accelerators are harvested out of real delivery experience rather than designed up front. They are the mechanism by which an Offering matures along its Conceptual → Delivered → Accelerated lifecycle: the more delivery experience captured as accelerators, the further along that lifecycle the offering sits.

How it connects: an Accelerator is part of a Standard Solution and embedded in an Offering. It is applied in an Implemented Solution and uses Technology."""@en ;
        skos:prefLabel "Accelerator"@en .

    <https://example.org/ecmp/lingaro/asset/standard-solution> a owl:Class ;
        rdfs:label "Standard Solution"@en ;
        rdfs:comment "A standardized, reusable delivery pattern for a recurring class of client problem, designed to be applied across clients with tailoring."@en ;
        skos:altLabel "Solution"@en ;
        skos:definition "A standardized, repeatable implementation pattern that addresses a recurring class of client problem (one or many use cases) and is designed to deliver a defined type of business value once applied. It combines domain expertise, technology, data products, processes, and accelerators, and is designed to be reused across clients with tailoring. It is not tied to any single client engagement. May be sold together with services, as part of an Offering, or alone."@en ;
        skos:prefLabel "Standard Solution"@en .

    <https://example.org/ecmp/lingaro/asset/asset> a owl:Class ;
        rdfs:label "Asset"@en ;
        rdfs:comment "The master type for anything Lingaro builds once and reuses many times, independent of any one client or engagement."@en ;
        skos:altLabel "IP Asset"@en,
            "Intellectual Property"@en,
            "Reusable Asset"@en ;
        skos:definition """Master object type for anything Lingaro builds once and reuses many times: a reusable artifact that is NOT client-specific and is NOT a per-engagement deliverable. An asset is owned by a squad or competency group, is versioned, has a maturity state, and can carry reuse/licensing rights. Every concrete asset is an instance of one of its subtypes (Accelerator, Standard Solution, White Paper, Framework, ...); Asset itself holds only the properties common to all of them — assetId, assetKind, owner, maturity, version, reuse rights, publication location. It exists so that offerings, services and engagements can point at "our reusable IP" without enumerating every subtype, and so that asset reuse can be counted.

How it connects: an Asset is packaged into an Offering and underpins a Service. It addresses a Use Case, is owned by a Group and authored by a Person, and is produced out of an Engagement. It uses Technology and is used in an Implemented Solution."""@en ;
        skos:prefLabel "Asset"@en .

    ns1:Domain a owl:Class ;
        rdfs:label "Domain"@en .

    <https://example.org/ecmp/lingaro/asset/contract> a owl:Class ;
        rdfs:label "Contract"@en ;
        rdfs:comment "The master document type governing commercial terms between Lingaro and another party."@en ;
        skos:altLabel "Agreement"@en,
            "Legal Document"@en ;
        skos:definition """Master object type for the document or file governing an engagement and/or commercial terms for cooperation between Lingaro and a client, subcontractor, third party or employee. Every contract instance is one of its subtypes — MSA, SoW, NDA, DPA, Employment Agreement, B2B Agreement, or an Amendment to any of them. Contract itself holds only what all of them share: contractId, contractKind, parties, signature and effective dates, term, governing law, status and storage location.

How it connects: a Contract governs an Engagement, is signed with a Client, a Person or a Group, and is stored in a Data Source."""@en ;
        skos:prefLabel "Contract"@en .
}

