            skos:Concept ;
        rdfs:label "AI compute" ;
        ns3:capability-link "Advanced processors are tied to AI capability" ;
        ns3:geopolitical-rationale "Access to high-end processors shapes innovation, surveillance, military applications, and industrial competitiveness" ;
