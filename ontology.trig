    <http://example.org/text-ontology/candidate/doc-d57fd025fa07132e/win-aa09c910529d21ee/fact/0/statement/0> a rdf:Statement ;
        rdf:object "Correctly mapping business time (months, weeks, visits) to calendar time is essential for every downstream feature — assortment stability, quantity reconciliation, target tracking, and rep productivity all depend on a shared, market-aware calendar." ;
        rdf:predicate ns2:business ;
        rdf:subject <http://example.org/text-ontology/entity/calendar-visit-plan> .

