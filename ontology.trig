    <http://example.org/text-ontology/entity/united-states> a ns1:Entity,
            <http://example.org/text-ontology/class/country>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "United States" ;
        ns3:critical-minerals-rationale "If rare earths and related inputs stay concentrated in Chinese-controlled supply chains, Western chip, defense, and clean-tech production remains exposed" ;
        ns3:mineral-strategy-aim "Not only price stability but reduced vulnerability to a crisis cutting access to Chinese-controlled supply" ;
        ns1:kind "Country" ;
        ns2:competes-with <http://example.org/text-ontology/entity/china> ;
        ns2:coordinates-mineral-strategy-with <http://example.org/text-ontology/entity/europe> ;
        ns2:export-restrictions-limit-chip-access-of <http://example.org/text-ontology/entity/china> ;
        ns2:introduced <http://example.org/text-ontology/entity/us-sanctions-waiver-on-russian-oil> ;
        rdfs:comment "Country whose trade, industrial policy, and defense planning are affected by competition with China" ;
        skos:altLabel "US",
            "Washington" ;
        skos:prefLabel "United States" .

    <http://example.org/text-ontology/class/event> a owl:Class ;
        rdfs:label "Event" ;
        rdfs:subClassOf ns1:Entity .

    <http://example.org/text-ontology/entity/europe> a ns1:Entity,
            <http://example.org/text-ontology/class/region>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Europe" ;
        ns3:mineral-strategy-aim "Not only price stability but reduced vulnerability to a crisis cutting access to Chinese-controlled supply" ;
        ns3:policy-framing "European policy discussions increasingly frame Chinese overcapacity as an economic security issue, not only a competition issue" ;
        ns3:sectors-affected-by-chinese-overcapacity "electric vehicles, solar components, wind equipment, semiconductors" ;
        ns1:kind "Region" ;
        ns2:coordinates-mineral-strategy-with <http://example.org/text-ontology/entity/united-states> ;
        rdfs:comment "Region whose political choices are affected by conflict involving Iran and whose trade and defense planning are affected by competition with China" ;
        skos:prefLabel "Europe" .

    <http://example.org/text-ontology/entity/china> a ns1:Entity,
            <http://example.org/text-ontology/class/country>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "China" ;
        ns3:chip-demand "Demand for advanced chips inside China remains strong despite US export restrictions" ;
        ns3:competition-impact "Semiconductor sector is one of the sharpest edges of competition between the United States and China",
            "affects trade, industrial policy, and defense planning across the United States, Europe, and East Asia" ;
        ns3:export-control-impact "Expanded export controls or tighter restrictions from Beijing can create immediate disruptions well beyond China itself" ;
        ns3:strategic-leverage "Major leverage in rare-earth processing and downstream manufacturing" ;
        ns1:kind "Country" ;
        ns2:industrial-overcapacity-affects <http://example.org/text-ontology/entity/europe> ;
