    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/1/statement/0> a rdf:Statement ;
        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Minimize the number of merchandisers required and total travel distance while meeting every store's visit frequency and duration requirements" ;
        rdf:predicate fact:business-need ;
        rdf:subject entity:merchandiser-resource-allocation ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-e68fe065f017f95e> .

    <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/2> a prov:Collection ;
        prov:hadMember <http://example.org/text-ontology/candidate/doc-e68fe065f017f95e/win-923f6576f7b75cef/fact/2/statement/0> ;
