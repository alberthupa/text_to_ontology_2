        ns2:decision-variables "binary variables indicating if a particular store is assigned to a particular schedule, plus auxiliary decision variables" ;
        ns2:goal "minimize the number of merchandisers needed" ;
        ns2:objective "avoid spikes in demand on any given day of the week; take into account political constraints; consider store proximity; include schedule fitness" ;
        ns2:output "set of stores to be visited on each day of the week" ;
        ns2:restrictions "visit frequency, duration, and what stores can be visited as part of the same route" ;
        ns3:kind "Model" ;
        ns4:assigns <http://example.org/text-ontology/entity/store> ;
