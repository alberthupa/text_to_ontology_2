<http://example.org/text-ontology/graphs/data> {
    <http://example.org/text-ontology/entity/france> a ns3:Entity,
            <http://example.org/text-ontology/class/country>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "France" ;
        ns3:kind "Country" ;
        rdfs:comment "A region identified in the brief's metadata." ;
        skos:prefLabel "France" .

    <http://example.org/text-ontology/entity/paris-talks> a ns3:Entity,
            <http://example.org/text-ontology/class/diplomatic-event>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Paris talks" ;
        ns2:did-not-remove-frictions-over "chips, trade, and strategic competition" ;
        ns2:diplomatic-purpose "stabilize a structurally adversarial relationship" ;
        ns2:suggested "both sides wanted some managed stability" ;
        ns3:kind "Diplomatic Event" ;
        ns1:concerns-relationship-between <http://example.org/text-ontology/entity/china>,
            <http://example.org/text-ontology/entity/united-states> ;
        ns1:held-in <http://example.org/text-ontology/entity/paris> ;
        ns1:prepared-for <http://example.org/text-ontology/entity/trump-xi-summit> ;
        rdfs:comment "Diplomatic talks framed as an effort to stabilize a structurally adversarial relationship and prepare for a future Trump-Xi summit." ;
        skos:altLabel "Talks in Paris" ;
        skos:prefLabel "Paris talks" .

    ns2:did-not-remove-frictions-over a owl:DatatypeProperty ;
        rdfs:label "did not remove frictions over" .

    ns2:diplomatic-purpose a owl:DatatypeProperty ;
        rdfs:label "diplomatic purpose" .

    ns2:status a owl:DatatypeProperty ;
        rdfs:label "status" .

    ns2:suggested a owl:DatatypeProperty ;
        rdfs:label "suggested" .

    ns1:concerns-relationship-between a owl:ObjectProperty ;
        rdfs:label "concerns relationship between" .

    ns1:held-in a owl:ObjectProperty ;
        rdfs:label "held in" .

    ns1:involves a owl:ObjectProperty ;
        rdfs:label "involves" .

    ns1:prepared-for a owl:ObjectProperty ;
        rdfs:label "prepared for" .

    <http://example.org/text-ontology/class/place> a owl:Class ;
        rdfs:label "Place" ;
        rdfs:subClassOf ns3:Entity .

    <http://example.org/text-ontology/entity/china> a ns3:Entity,
            <http://example.org/text-ontology/class/country>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "China" ;
        ns3:kind "Country" ;
        rdfs:comment "One side in the relationship discussed in the diplomatic brief." ;
        skos:prefLabel "China" .

    <http://example.org/text-ontology/entity/paris> a ns3:Entity,
            <http://example.org/text-ontology/class/place>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Paris" ;
        ns3:kind "Place" ;
        rdfs:comment "City where the diplomatic talks occurred." ;
        skos:prefLabel "Paris" .

    <http://example.org/text-ontology/entity/trump> a ns3:Entity,
            <http://example.org/text-ontology/class/person>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Trump" ;
        ns3:kind "Person" ;
        rdfs:comment "One of the two leaders expected to participate in a future summit." ;
        skos:prefLabel "Trump" .

    <http://example.org/text-ontology/entity/trump-xi-summit> a ns3:Entity,
            <http://example.org/text-ontology/class/diplomatic-event>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Trump-Xi summit" ;
        ns2:status "future summit" ;
        ns3:kind "Diplomatic Event" ;
        ns1:involves <http://example.org/text-ontology/entity/trump>,
            <http://example.org/text-ontology/entity/xi> ;
        rdfs:comment "A future summit involving Trump and Xi for which officials sought to prepare the ground." ;
        skos:prefLabel "Trump-Xi summit" .

    <http://example.org/text-ontology/entity/united-states> a ns3:Entity,
            <http://example.org/text-ontology/class/country>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "United States" ;
        ns3:kind "Country" ;
        rdfs:comment "One side in the relationship discussed in the diplomatic brief." ;
        skos:prefLabel "United States" .

    <http://example.org/text-ontology/entity/xi> a ns3:Entity,
            <http://example.org/text-ontology/class/person>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Xi" ;
        ns3:kind "Person" ;
        rdfs:comment "One of the two leaders expected to participate in a future summit." ;
        skos:prefLabel "Xi" .

    <http://example.org/text-ontology/class/diplomatic-event> a owl:Class ;
        rdfs:label "Diplomatic Event" ;
        rdfs:subClassOf ns3:Entity .

    <http://example.org/text-ontology/class/person> a owl:Class ;
        rdfs:label "Person" ;
        rdfs:subClassOf ns3:Entity .

    <http://example.org/text-ontology/class/country> a owl:Class ;
        rdfs:label "Country" ;
        rdfs:subClassOf ns3:Entity .
}

