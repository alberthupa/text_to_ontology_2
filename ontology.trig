        onto:sourceFile <http://example.org/text-ontology/source-file/dc8f3463ffe80a9ed7acaf75958554f899d153e45d0a96169ad88aeb09efd322> ;
        rdf:object "Three sequential optimization models: (1) assigning visit schedules to stores, (2) optimizing daily routes, (3) optimizing weekly schedules; innovative methodology allowing for high quality solutions while greatly reducing computational effort and time; delivered as a tool generating optimized deployment plans and most effective routes for merchandisers" ;
        rdf:predicate fact:proposed-solution ;
        rdf:subject entity:merchandiser-resource-allocation ;
        prov:wasDerivedFrom <http://example.org/text-ontology/document/doc-e68fe065f017f95e> .

