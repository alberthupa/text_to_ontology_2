<http://example.org/text-ontology/graphs/data> {
    <http://example.org/text-ontology/entity/ai-compute-competition-as-a-geopolitical-driver> a ns1:Entity,
            <http://example.org/text-ontology/class/document>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "AI compute competition as a geopolitical driver" ;
        ns3:benchmark-purpose "Tests whether the memory system preserves both incentive and constraint in one answer" ;
        ns3:purpose "Lets the memory system demonstrate that it can connect AI to industrial policy and export controls" ;
        ns3:reason-for-inclusion "Captures the logic of tactical accommodation under stress" ;
        ns1:kind "Document" ;
        ns2:discusses <http://example.org/text-ontology/entity/ai-compute>,
            <http://example.org/text-ontology/entity/chip-restrictions>,
            <http://example.org/text-ontology/entity/joint-oil-exploration-with-china> ;
        rdfs:comment "Benchmark note explaining why AI compute is treated as a geopolitical driver and why chip restrictions appear repeatedly across the corpus" ;
        skos:altLabel "Joint oil exploration with China as a tactical option",
            "This note" ;
        skos:prefLabel "AI compute competition as a geopolitical driver" .

    <http://example.org/text-ontology/entity/chinese-technology-firms> a ns1:Entity,
            <http://example.org/text-ontology/class/organization>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Chinese technology firms" ;
        ns3:reported-orders "Large orders for high-end processors for 2026 delivery" ;
        ns1:kind "Organization" ;
        ns2:based-in <http://example.org/text-ontology/entity/china> ;
        rdfs:comment "Chinese technology companies that reportedly continued placing large orders for high-end processors for 2026 delivery" ;
        skos:prefLabel "Chinese technology firms" .

    <http://example.org/text-ontology/entity/critical-minerals-and-supply-chain-security> a ns1:Entity,
            <http://example.org/text-ontology/class/document>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Critical minerals and supply-chain security" ;
        ns3:key-claim "Critical minerals have become a strategic issue rather than a niche industrial topic, driven by concentration risk",
            "Mineral security, energy security, and industrial policy are now linked parts of one strategic problem" ;
        ns1:kind "Document" ;
        ns2:discusses <http://example.org/text-ontology/entity/china>,
            <http://example.org/text-ontology/entity/europe>,
            <http://example.org/text-ontology/entity/united-states> ;
        rdfs:comment "Overview document describing critical minerals as a strategic issue, concentration risk in Chinese rare-earth processing, material dependencies in chips, defense, and energy transition, and emerging European-US coordination on mineral strategy" ;
        skos:prefLabel "Critical minerals and supply-chain security" .

    <http://example.org/text-ontology/entity/energy-crunch> a ns1:Entity,
            <http://example.org/text-ontology/class/event>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Energy crunch" ;
        ns1:kind "Event" ;
        ns2:increased-appeal-of <http://example.org/text-ontology/entity/joint-oil-exploration-with-china> ;
        rdfs:comment "Deepening energy emergency that made compromise or partial reset with China, including joint exploration, more attractive" ;
        skos:altLabel "energy emergency" ;
        skos:prefLabel "Energy crunch" .

    <http://example.org/text-ontology/entity/global-risk-overview-april-2026-snapshot> a ns1:Entity,
            <http://example.org/text-ontology/class/document>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Global risk overview, April 2026 snapshot" ;
        ns3:critical-chokepoints-identified "Strait of Hormuz (oil), rare earths (industrial production and defense manufacturing), advanced chips (AI capacity and high-end computing)" ;
        ns3:cross-cutting-patterns "geoeconomic tools used as strategic weapons; critical chokepoints matter more than ever; regional crises are no longer regionally contained" ;
        ns3:date "April 2026" ;
        ns3:geoeconomic-tools-identified "tariffs, export controls, sanctions waivers, procurement restrictions, supply agreements" ;
        ns3:key-drivers-of-early-2026-geopolitical-environment "interstate conflict, geoeconomic confrontation, supply-chain stress, energy insecurity" ;
        ns1:kind "Document" ;
        ns2:cites <http://example.org/text-ontology/entity/world-economic-forum-2026-global-risks-work> ;
        rdfs:comment "Overview document describing the early-2026 geopolitical environment shaped by interstate conflict, geoeconomic confrontation, supply-chain stress, and energy insecurity" ;
        skos:prefLabel "Global risk overview, April 2026 snapshot" .

    <http://example.org/text-ontology/entity/kirill-dmitriev> a ns1:Entity,
            <http://example.org/text-ontology/class/person>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Kirill Dmitriev" ;
        ns3:role "Russian envoy" ;
        ns1:kind "Person" ;
        ns2:envoy-of <http://example.org/text-ontology/entity/russia> ;
        ns2:visited <http://example.org/text-ontology/entity/united-states> ;
        rdfs:comment "Russian envoy who visited Washington amid discussion of sanctions relief and possible peace terms" ;
        skos:prefLabel "Kirill Dmitriev" .

    <http://example.org/text-ontology/entity/nvidia> a ns1:Entity,
            <http://example.org/text-ontology/class/organization>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Nvidia" ;
        ns1:kind "Organization" ;
        rdfs:comment "Chip company whose restricted GPUs were reportedly contained in servers that someone attempted to move toward Chinese buyers" ;
        skos:prefLabel "Nvidia" .

    <http://example.org/text-ontology/entity/paris-talks> a ns1:Entity,
            <http://example.org/text-ontology/class/event>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Paris talks" ;
        ns3:assessment "Both sides still wanted a degree of managed stability even while structural frictions remained unresolved" ;
        ns1:kind "Event" ;
        ns2:held-in <http://example.org/text-ontology/entity/paris> ;
        ns2:prepares <http://example.org/text-ontology/entity/trump-xi-summit> ;
        rdfs:comment "Diplomatic talks held in Paris by officials to prepare a future Trump-Xi summit, suggesting both sides still wanted managed stability" ;
        skos:prefLabel "Paris talks" .

    <http://example.org/text-ontology/entity/russia-ukraine-war-sanctions-and-stalled-diplomacy> a ns1:Entity,
            <http://example.org/text-ontology/class/document>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Russia-Ukraine war, sanctions, and stalled diplomacy" ;
        ns3:time-frame "April 2026" ;
        ns1:kind "Document" ;
        ns2:discusses <http://example.org/text-ontology/entity/nato>,
            <http://example.org/text-ontology/entity/orthodox-easter-ceasefire>,
            <http://example.org/text-ontology/entity/russia>,
            <http://example.org/text-ontology/entity/russia-ukraine-war>,
            <http://example.org/text-ontology/entity/ukraine>,
            <http://example.org/text-ontology/entity/united-states>,
            <http://example.org/text-ontology/entity/us-sanctions-waiver-on-russian-oil> ;
        rdfs:comment "Overview document describing the state of Russia-Ukraine war diplomacy by April 2026, including the US sanctions waiver on Russian oil, Dmitriev's Washington visit, disagreements over peace terms, the Orthodox Easter ceasefire, Ukrainian strikes on Russian refining, and NATO deterrence emphasis" ;
        skos:prefLabel "Russia-Ukraine war, sanctions, and stalled diplomacy" .

    <http://example.org/text-ontology/entity/territorial-disputes-with-china> a ns1:Entity,
            <http://example.org/text-ontology/class/entity>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Territorial disputes with China" ;
        ns3:status "Unresolved" ;
        ns1:kind "Entity" ;
        ns2:involves <http://example.org/text-ontology/entity/china> ;
        ns2:obstacle-to <http://example.org/text-ontology/entity/joint-oil-exploration-with-china> ;
        rdfs:comment "Unresolved territorial disputes that, together with constitutional obstacles, made joint exploration with China politically difficult" ;
        skos:altLabel "territorial obstacles" ;
        skos:prefLabel "Territorial disputes with China" .

    <http://example.org/text-ontology/entity/us-china-eu-trade-and-semiconductor-tensions> a ns1:Entity,
            <http://example.org/text-ontology/class/document>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "US-China-EU trade and semiconductor tensions" ;
        ns3:cross-cutting-patterns "Tactical dialogue continues, but competition over chips, industrial policy, and supply chains remains fundamental rather than temporary" ;
        ns3:key-lesson "Technology controls can redirect trade into opaque channels when demand remains strategically important; export controls changed supply channels more than they eliminated demand" ;
        ns3:reported-case "Attempts to move large volumes of servers containing restricted Nvidia GPUs toward Chinese buyers" ;
        ns1:kind "Document" ;
        ns2:discusses <http://example.org/text-ontology/entity/china>,
            <http://example.org/text-ontology/entity/europe>,
            <http://example.org/text-ontology/entity/united-states> ;
        rdfs:comment "Overview document on trade and semiconductor competition between the United States, China, and Europe, covering export controls, gray-market routing, industrial overcapacity, critical minerals coordination, and summit diplomacy" ;
        skos:prefLabel "US-China-EU trade and semiconductor tensions" .

