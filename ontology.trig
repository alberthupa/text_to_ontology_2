    <http://example.org/text-ontology/entity/merchandiser-resource-allocation> a ns3:Entity,
            <http://example.org/text-ontology/class/project>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Merchandiser Resource Allocation" ;
        ns2:approach "Mixed Integer Linear Programming with constraints derived from pre-processed merchandiser and point-of-sale data, an objective function for the optimization target, and a dedicated solver",
            "Three sequential optimization models: (1) assigning visit schedules to stores, (2) optimizing daily routes, (3) optimizing weekly schedules" ;
        ns2:basis "Start data for new stores (cold start) calculated using average data for similar stores with history via KNN algorithm" ;
        ns2:business "Allocate merchandiser visits to stores while minimizing headcount and travel distance and maintaining proper service level for all stores" ;
        ns2:cost-exclusion "Proposal does not cover any Infrastructure costs" ;
        ns2:data-assumption "Historical data is uploaded into Snowflake frequently enough to include fresh information in expected plan generation frequency",
            "Merchandiser historical deployment cost data is available in Snowflake",
            "Merchandisers data is available in Snowflake",
            "Point of Sales data (including sales GAP) is available in Snowflake",
            "Sales per door data is available in Snowflake",
            "Visit time data or algorithm recipe is provided by Nestlé" ;
        ns2:deployment-parameters "political constraints, proximity/geographic location, sales, account type, roving/stationary status" ;
        ns2:estimated-headcount-reduction "30%" ;
        ns2:format "pptx presentation converted to markdown; high level overview" ;
        ns2:fte-reduction-range "20% to 44% depending on regional characteristics" ;
        ns2:high-level-process "Input → Cyclic Scheduling & Allocation Process → Prediction of input data for New Stores" ;
        ns2:milestones "Input Scope, Parameter/Restriction setting, Optimization Methodology, Output Wireframe, Output Application Trial (for discussion)" ;
        ns2:motivation "Upcoming wage increase; lack of established processes for merchandiser allocation" ;
        ns2:need "A solution to automate the deployment planning process and provide optimized routes to reduce cost and maximize coverage" ;
        ns2:objective "Develop a tool to determine the best/most cost-efficient way to deploy merchandisers to cover the most doors",
            "determine the best and most cost-efficient way to deploy merchandisers on the field",
            "most cost-efficient way to deploy merchandisers on the field taking into consideration additional variables" ;
        ns2:optimization-target "most cost-efficient way to deploy merchandisers on the field" ;
        ns2:outcomes "Reduction in FTE requirements (20% to 44% based on regional characteristics); overall estimated headcount reduction of 30%; identification of new opportunities for coverage expansion" ;
        ns2:problem-statement "Efficiently deploy merchandisers to cover a large number of doors while considering business restrictions and optimizing routes based on proximity, sales, and account information; existing process not optimal, causing inefficiencies in headcount, travel distance and time spent" ;
        ns2:recommendation "ask FICO for a price for this project and validate the offer; switching to a different technology is possible" ;
        ns2:requirement "adapt merchandiser resource allocation strategies to dynamic market and political conditions",
            "input and manage business and political restrictions affecting merchandiser deployment",
            "utilize proximity and geographic location data for optimized merchandiser deployment planning" ;
