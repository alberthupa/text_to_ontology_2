    <http://example.org/text-ontology/entity/talk-to-data-offering> a ns3:Entity,
            <http://example.org/text-ontology/class/project>,
            owl:NamedIndividual,
            skos:Concept ;
        rdfs:label "Talk to Data offering" ;
        ns2:addressed-pain-points "Static dashboards and reports (only pre-defined questions); dependency on technical teams; slow time to insight; fragmented information across systems and documents" ;
        ns2:challenge-opportunity "people no longer just want dashboards and reports; they want to interact with the data" ;
        ns2:delivery-approach "UX/UI, evaluation, adoption" ;
        ns2:experience-depends-on "User context, task complexity, and interaction environment" ;
        ns2:how-it-works "1) Ask in natural language (no SQL, schemas, or tool training); 2) Understand intent (AI interprets question and maps business meaning); 3) Query the right sources (structured data, documents, or both); 4) Return the answer (summary, metric, chart, explanation, citation)" ;
        ns2:modalities "text vs voice chatbots" ;
        ns2:plan-section-count "9" ;
        ns2:recommended-ux "In many scenarios the strongest UX is multimodal: text and visuals for precision, traceability, and deeper analysis; voice for convenience and accessibility" ;
        ns2:scaling-topic "how to scale talk-to-data with multiple t2d solutions" ;
        ns2:tagline "Enabling self-service access to enterprise data and knowledge through conversational AI" ;
        ns2:technical-components "RAG, semantic layer" ;
        ns2:technology-range "from no code through low code to bespoke" ;
        ns2:types "structured vs. unstructured, RAG, nl2sql" ;
        ns2:user-capabilities "Ask in plain language; explore with guidance; get instant answers; access all data in one interface" ;
        ns2:value-proposition "A natural-language interface for trusted business answers; from consumption to conversation" ;
        ns3:kind "Project" ;
        ns4:delivered-on <http://example.org/text-ontology/entity/azure>,
            <http://example.org/text-ontology/entity/gcp> ;
        ns4:uses-technique <http://example.org/text-ontology/entity/nl2sql>,
            <http://example.org/text-ontology/entity/rag> ;
        rdfs:comment "Offering component about interacting with data beyond dashboards and reports; high-level plan covers why, types (structured vs unstructured, RAG, nl2sql), modality, tools, technology (no code to bespoke on Azure, GCP), technical components (RAG, semantic layer), delivery approach, case studies, and scaling" ;
        skos:altLabel "Talk to Data",
            "t2d",
            "talk-to-data" ;
        skos:prefLabel "Talk to Data offering" .

