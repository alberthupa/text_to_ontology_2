# Lingaro knowledge assets and their relationships, exported from ECMP.
# Classification of every asset below: Public.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix ecmp: <https://example.org/ecmp/vocab#> .
@prefix lg:   <https://example.org/ecmp/lingaro/asset/> .
@prefix lgd:  <https://example.org/ecmp/lingaro/domain/> .

### Vocabulary: classes and properties ECMP adds on top of SKOS

ecmp:Domain
    a owl:Class ;
    rdfs:label "Domain"@en .

ecmp:CompanyProfile
    a owl:Class ;
    rdfs:label "Company profile"@en .

ecmp:DataAsset
    a owl:Class ;
    rdfs:label "Data asset"@en .

ecmp:Process
    a owl:Class ;
    rdfs:label "Process"@en .

ecmp:domain
    a owl:ObjectProperty ;
    rdfs:label "domain"@en .

ecmp:classification
    a owl:DatatypeProperty ;
    rdfs:label "classification"@en .

ecmp:sourceSystem
    a owl:DatatypeProperty ;
    rdfs:label "source system"@en .

ecmp:formula
    a owl:DatatypeProperty ;
    rdfs:label "formula"@en .

ecmp:unit
    a owl:DatatypeProperty ;
    rdfs:label "unit"@en .

ecmp:grain
    a owl:DatatypeProperty ;
    rdfs:label "grain"@en .

ecmp:whenToUse
    a owl:DatatypeProperty ;
    rdfs:label "when to use"@en .

ecmp:howToUse
    a owl:DatatypeProperty ;
    rdfs:label "how to use"@en .

ecmp:purpose
    a owl:DatatypeProperty ;
    rdfs:label "purpose"@en .

ecmp:primaryKey
    a owl:DatatypeProperty ;
    rdfs:label "primary key"@en .

ecmp:legalName
    a owl:DatatypeProperty ;
    rdfs:label "legal name"@en .

ecmp:headquarters
    a owl:DatatypeProperty ;
    rdfs:label "headquarters"@en .

ecmp:industry
    a owl:DatatypeProperty ;
    rdfs:label "industry"@en .

ecmp:employeeBand
    a owl:DatatypeProperty ;
    rdfs:label "employee band"@en .

ecmp:builtFrom
    a owl:ObjectProperty ;
    rdfs:label "Built from"@en ;
    rdfs:comment "The assets this report is computed from. Points from the consumer to what it reads."@en ;
    owl:inverseOf ecmp:feeds .

ecmp:feeds
    a owl:ObjectProperty ;
    rdfs:label "Feeds"@en ;
    rdfs:comment "The reports computed from this asset."@en ;
    owl:inverseOf ecmp:builtFrom .

ecmp:hasSubsidiary
    a owl:ObjectProperty ;
    rdfs:label "Has subsidiary"@en ;
    rdfs:comment "The legal entities this company owns. Transitive, mirroring subsidiary_of."@en ;
    owl:inverseOf ecmp:subsidiaryOf .

ecmp:measuredBy
    a owl:ObjectProperty ;
    rdfs:label "Measured by"@en ;
    rdfs:comment "The metric that quantifies this concept."@en ;
    owl:inverseOf ecmp:measures .

ecmp:measures
    a owl:ObjectProperty ;
    rdfs:label "Measures"@en ;
    rdfs:comment "The concept this metric quantifies."@en ;
    owl:inverseOf ecmp:measuredBy .

ecmp:storedIn
    a owl:ObjectProperty ;
    rdfs:label "Stored in"@en ;
    rdfs:comment "The data asset holding instances of this concept. Points from the definition to the data."@en ;
    owl:inverseOf ecmp:stores .

ecmp:stores
    a owl:ObjectProperty ;
    rdfs:label "Stores"@en ;
    rdfs:comment "The concepts whose instances this data asset holds."@en ;
    owl:inverseOf ecmp:storedIn .

ecmp:subsidiaryOf
    a owl:ObjectProperty ;
    rdfs:label "Subsidiary of"@en ;
    rdfs:comment "The parent company of this legal entity. Transitive: a subsidiary of a subsidiary is a subsidiary."@en ;
    owl:inverseOf ecmp:hasSubsidiary .

